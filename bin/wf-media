#!/usr/bin/env python3
"""
wf-media - Tier 2: Sovereign Media & YouTube Handler for Webflow
Routes video streams and YouTube pages to youtube-tui, ytfzf, or hardware-accelerated mpv,
bypassing heavy browser MSE video decoding and ads.
"""
import os
import sys
import re
import shutil
import argparse
import urllib.parse
import subprocess


def is_direct_video_url(url: str) -> bool:
    parsed = urllib.parse.urlparse(url)
    host = parsed.netloc.lower()
    path = parsed.path.lower()

    if "youtu.be" in host and len(path) > 1:
        return True
    if "youtube.com" in host:
        if path.startswith(("/watch", "/shorts/", "/live/", "/embed/")):
            return True
    if any(h in host for h in ("twitch.tv", "vimeo.com", "odysee.com", "bilibili.com")):
        if len(path.strip("/")) > 0:
            return True
    if path.endswith((".mp4", ".webm", ".mkv", ".m3u8", ".mp3", ".ogg", ".flac")):
        return True
    return False


def launch_media(url: str, prefer_tui: bool = False):
    has_yt_tui = shutil.which("youtube-tui") is not None
    has_ytfzf = shutil.which("ytfzf") is not None
    has_mpv = shutil.which("mpv") is not None
    has_kitty = shutil.which("kitty") is not None

    direct_video = is_direct_video_url(url)

    # 1. If user prefers TUI or URL is a YouTube browsing/search page (not a single video)
    if (prefer_tui or not direct_video) and "youtube.com" in url.lower():
        if has_yt_tui:
            if sys.stdout.isatty():
                os.execvp("youtube-tui", ["youtube-tui"])
            elif has_kitty:
                subprocess.Popen(["kitty", "--class", "wf-media", "-e", "youtube-tui"], start_new_session=True)
                return
        elif has_ytfzf:
            if sys.stdout.isatty():
                os.execvp("ytfzf", ["ytfzf"])
            elif has_kitty:
                subprocess.Popen(["kitty", "--class", "wf-media", "-e", "ytfzf"], start_new_session=True)
                return

    # 2. Direct Video / Stream -> Launch hardware-accelerated mpv (Zero browser RAM, zero ads)
    if has_mpv and (direct_video or prefer_tui is False):
        mpv_cmd = [
            "mpv",
            "--hwdec=auto",
            "--vo=gpu",
            "--ytdl-format=bestvideo[height<=?1080]+bestaudio/best",
            "--force-window=immediate",
            f"--title=wf-media - {url}",
            url
        ]
        subprocess.Popen(
            mpv_cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )
        return

    # 3. Fallback if mpv isn't available but a TUI is
    if has_yt_tui:
        if sys.stdout.isatty():
            os.execvp("youtube-tui", ["youtube-tui"])
        elif has_kitty:
            subprocess.Popen(["kitty", "--class", "wf-media", "-e", "youtube-tui"], start_new_session=True)
            return
    elif has_ytfzf:
        if sys.stdout.isatty():
            os.execvp("ytfzf", ["ytfzf"])
        elif has_kitty:
            subprocess.Popen(["kitty", "--class", "wf-media", "-e", "ytfzf"], start_new_session=True)
            return

    sys.stderr.write("[-] Neither 'mpv' nor 'youtube-tui'/'ytfzf' found. Install mpv + yt-dlp or youtube-tui.\n")
    sys.exit(1)


def main():
    parser = argparse.ArgumentParser(description="Webflow Tier 2 Media Handler")
    parser.add_argument("url", help="Target Media / YouTube URL")
    parser.add_argument("--tui", action="store_true", help="Prefer youtube-tui / ytfzf over direct mpv playback")
    args = parser.parse_args()
    launch_media(args.url.strip(), prefer_tui=args.tui)


if __name__ == "__main__":
    main()
