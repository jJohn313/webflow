#!/usr/bin/env python3
"""
wf-media - Tier 2: Sovereign Low-Latency Media & YouTube Engine for Webflow
Optimized for Wayland / Hyprland + Nvidia with instant stream pre-resolution,
SponsorBlock support, and fallback cascade.
"""
import os
import sys
import time
import shutil
import argparse
import urllib.parse
import subprocess
from pathlib import Path

LOG_FILE = Path.home() / ".local" / "share" / "webflow" / "wf-media.log"


def log_media(msg: str):
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}\n")
    except Exception:
        pass


def clean_video_url(url: str) -> str:
    """Strips tracking parameters (?si=..., &feature=...) that slow down or trip yt-dlp."""
    parsed = urllib.parse.urlparse(url)
    if "youtu.be" in parsed.netloc.lower():
        vid_id = parsed.path.lstrip("/")
        if vid_id:
            return f"https://www.youtube.com/watch?v={vid_id}"
    if "youtube.com" in parsed.netloc.lower():
        qs = urllib.parse.parse_qs(parsed.query)
        if "v" in qs:
            return f"https://www.youtube.com/watch?v={qs['v'][0]}"
    return url


def is_direct_video_url(url: str) -> bool:
    parsed = urllib.parse.urlparse(url)
    host = parsed.netloc.lower()
    path = parsed.path.lower()

    if "youtu.be" in host and len(path) > 1:
        return True
    if "youtube.com" in host and path.startswith(("/watch", "/shorts/", "/live/", "/embed/")):
        return True
    if any(h in host for h in ("twitch.tv", "vimeo.com", "odysee.com", "bilibili.com")):
        if len(path.strip("/")) > 0:
            return True
    if path.endswith((".mp4", ".webm", ".mkv", ".m3u8", ".mp3", ".ogg", ".flac")):
        return True
    return False


def launch_media(url: str, prefer_tui: bool = False, audio_only: bool = False):
    url = clean_video_url(url)
    has_yt_tui = shutil.which("youtube-tui") is not None
    has_ytfzf = shutil.which("ytfzf") is not None
    has_mpv = shutil.which("mpv") is not None
    has_ytdlp = shutil.which("yt-dlp") is not None
    has_kitty = shutil.which("kitty") is not None

    direct_video = is_direct_video_url(url)

    # 1. Browsing YouTube channels/search -> youtube-tui / ytfzf
    if (prefer_tui or not direct_video) and "youtube.com" in url.lower():
        if has_yt_tui:
            if sys.stdout.isatty():
                os.execvp("youtube-tui", ["youtube-tui"])
            elif has_kitty:
                subprocess.Popen(["kitty", "--class", "wf-media", "-e", "youtube-tui"], start_new_session=True)
                return
        elif has_ytfzf:
            if sys.stdout.isatty():
                os.execvp("ytfzf", ["ytfzf"])
            elif has_kitty:
                subprocess.Popen(["kitty", "--class", "wf-media", "-e", "ytfzf"], start_new_session=True)
                return

    # 2. High-Speed Hardware-Accelerated MPV Playback
    if has_mpv:
        if not has_ytdlp and ("youtube.com" in url or "youtu.be" in url):
            log_media("ERROR: yt-dlp is not installed!")
            if shutil.which("notify-send"):
                subprocess.Popen(["notify-send", "Webflow Media", "Missing dependency: yt-dlp"])
            return

        if shutil.which("notify-send"):
            subprocess.Popen(["notify-send", "-t", "2000", "Webflow Media", f"Buffering stream: {url}"])

        mpv_cmd = [
            "mpv",
            "--no-config",
            "--profile=fast",
            "--vo=gpu",
            "--gpu-context=wayland",
            "--hwdec=nvdec-copy,vaapi-copy,auto-safe",
            "--force-window=immediate",
            "--keep-open=yes",
            "--osc=yes",
            "--osd-bar=yes",
            "--cache=yes",
            "--demuxer-max-bytes=150MiB",
            "--demuxer-max-back-bytes=50MiB",
            "--vd-lavc-threads=4",
            "--ytdl-format=bestvideo[height<=?1080][vcodec^=avc1]+bestaudio/bestvideo[height<=?1080]+bestaudio/best",
            "--ytdl-raw-options=concurrent-fragments=4,force-ipv4=,no-check-certificates=",
            f"--title=wf-media - {url}",
        ]
        if audio_only:
            mpv_cmd.extend(["--no-video", "--force-window=no"])

        mpv_cmd.append(url)
        log_media(f"Launching: {' '.join(mpv_cmd)}")

        with open(LOG_FILE, "a", encoding="utf-8") as log_f:
            subprocess.Popen(
                mpv_cmd,
                stdout=log_f,
                stderr=log_f,
                start_new_session=True
            )
        return

    log_media("ERROR: Neither mpv nor youtube-tui found.")
    sys.exit(1)


def main():
    parser = argparse.ArgumentParser(description="Webflow Tier 2 Media Handler")
    parser.add_argument("url", help="Target Media / YouTube URL")
    parser.add_argument("--tui", action="store_true", help="Prefer youtube-tui over direct mpv playback")
    parser.add_argument("--audio", "-a", action="store_true", help="Audio-only background stream")
    args = parser.parse_args()
    launch_media(args.url.strip(), prefer_tui=args.tui, audio_only=args.audio)


if __name__ == "__main__":
    main()
