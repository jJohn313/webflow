#!/usr/bin/env bash
# wf-pass - Active-Window Credential Injector for Webflow
set -euo pipefail

WINDOW_INFO=""
if command -v hyprctl >/dev/null 2>&1; then
    WINDOW_INFO="$(hyprctl activewindow -j 2>/dev/null || true)"
fi

DOMAIN=""
if [[ -n "${WINDOW_INFO}" ]]; then
    TITLE=$(echo "${WINDOW_INFO}" | grep -o '"title": *"[^"]*"' | head -n1 | cut -d'"' -f4 || true)
    # 1. Try explicit (@domain.com) marker from wf-view
    DOMAIN=$(echo "${TITLE}" | grep -oE '\(@([a-zA-Z0-9.-]+\.[a-zA-Z]{2,})\)' | tr -d '(@)' | head -n1 || true)
    # 2. Fallback to any domain pattern in title
    if [[ -z "${DOMAIN}" ]]; then
        DOMAIN=$(echo "${TITLE}" | grep -oE '([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}' | head -n1 || true)
    fi
fi

if [[ -z "${DOMAIN}" ]]; then
    if command -v rofi >/dev/null 2>&1; then
        DOMAIN=$(rofi -dmenu -p "Login domain: " || true)
    else
        read -r -p "Target domain for credentials: " DOMAIN
    fi
fi

if [[ -z "${DOMAIN}" ]]; then
    echo "[-] No domain detected or specified."
    exit 1
fi

echo "[*] Searching credentials for domain: ${DOMAIN}"

USER=""
PASS=""

# Try rbw (Bitwarden CLI)
if command -v rbw >/dev/null 2>&1 && rbw unlocked >/dev/null 2>&1; then
    ENTRY_ID=$(rbw list --fields id,name,user 2>/dev/null | grep -i "${DOMAIN}" | head -n1 | cut -f1 || true)
    if [[ -n "${ENTRY_ID}" ]]; then
        USER=$(rbw get --field username "${ENTRY_ID}" 2>/dev/null || true)
        PASS=$(rbw get "${ENTRY_ID}" 2>/dev/null | head -n1 || true)
    fi
fi

# Try pass (standard unix password store)
if [[ -z "${PASS}" ]] && command -v pass >/dev/null 2>&1; then
    PASS_ENTRY=$(pass find "${DOMAIN}" 2>/dev/null | sed 's/\x1B\[[0-9;]*[a-zA-Z]//g' | grep -v 'Search terms' | grep -v '/$' | head -n1 | sed 's/^[├└─│ ]*//;s/\.gpg$//' || true)
    if [[ -n "${PASS_ENTRY}" ]]; then
        STORE_DIR="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
        FULL_ENTRY=$(find "${STORE_DIR}" -type f -iname "*${DOMAIN}*.gpg" 2>/dev/null | head -n1 | sed "s|^${STORE_DIR}/||;s|\.gpg$||" || true)
        TARGET_ENTRY="${FULL_ENTRY:-$PASS_ENTRY}"
        PASS=$(pass show "${TARGET_ENTRY}" 2>/dev/null | head -n1 || true)
        USER=$(pass show "${TARGET_ENTRY}" 2>/dev/null | grep -iE '^(user|username|login|email):' | head -n1 | cut -d':' -f2- | xargs || true)
    fi
fi

if [[ -z "${PASS}" ]]; then
    echo "[-] No matching credentials found in rbw or pass for ${DOMAIN}."
    exit 1
fi

if ! command -v wtype >/dev/null 2>&1; then
    echo "[-] wtype utility is required for keystroke synthesis."
    exit 1
fi

sleep 0.1
if [[ -n "${USER}" ]]; then
    wtype -s 15 -- "${USER}"
    wtype -k Tab
    sleep 0.05
fi
wtype -s 15 -- "${PASS}"
wtype -k Return
