#!/usr/bin/env python3
"""
wf-tier - Fast Heuristic & Rule-Based Webpage Tier Classifier for Webflow
Determines whether a target URL is:
  - TIER1: Text/Article/Document suited for terminal reader (wf-reader)
  - TIER3: Interactive Web App/SPA suited for modal WebKitGTK viewer (wf-view)
"""
import os
import sys
import re
import argparse
import urllib.parse
import urllib.request
from pathlib import Path

CONFIG_PATHS = [
    Path(__file__).resolve().parent.parent / "config" / "rules.conf",
    Path.home() / ".config" / "webflow" / "rules.conf"
]


def load_rules():
    tier1_rules = []
    tier2_rules = []
    tier3_rules = []
    for path in CONFIG_PATHS:
        if not path.exists():
            continue
        active_section = None
        try:
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if line == "[TIER1_ONLY]":
                    active_section = "TIER1"
                elif line == "[TIER2_ONLY]":
                    active_section = "TIER2"
                elif line == "[TIER3_ONLY]":
                    active_section = "TIER3"
                elif active_section == "TIER1" and line not in tier1_rules:
                    tier1_rules.append(line)
                elif active_section == "TIER2" and line not in tier2_rules:
                    tier2_rules.append(line)
                elif active_section == "TIER3" and line not in tier3_rules:
                    tier3_rules.append(line)
        except Exception:
            pass
    return tier1_rules, tier2_rules, tier3_rules


def matches_rule(url: str, rules: list):
    parsed = urllib.parse.urlparse(url)
    target = f"{parsed.netloc}{parsed.path}"
    for rule in rules:
        if rule in target:
            return rule
        try:
            if re.search(rule, target, re.IGNORECASE):
                return rule
        except re.error:
            pass
    return None


def probe_url(url: str, timeout: float = 3.0):
    """
    Streaming probe (up to 256 KB) checking Content-Type, OpenGraph/Schema
    article metadata, SPA mounting containers, and semantic text density.
    Returns (tier, reason)
    """
    p = urllib.parse.urlparse(url)
    h = p.netloc.lower()
    path = p.path.lower()

    # Fast path & subdomain hints
    is_path_article = bool(re.search(r"/(wikis?|guides?|walkthroughs?|articles?|reviews?|news|blogs?|posts?|stories|docs?|titles?|tutorials?|how-tos?)/", path))
    is_subdomain_doc = bool(re.search(r"^(wiki|docs?|man|blog|news|developer)\.", h))

    headers = {
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.9",
        "Sec-Fetch-Dest": "document",
        "Sec-Fetch-Mode": "navigate",
        "Sec-Fetch-Site": "none",
        "Sec-Fetch-User": "?1",
        "Upgrade-Insecure-Requests": "1"
    }

    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            content_type = resp.headers.get("Content-Type", "").lower()
            if "text/html" not in content_type and "application/xhtml" not in content_type:
                return "TIER3", f"Non-HTML Content-Type: {content_type}"

            chunk = resp.read(262144).decode("utf-8", errors="replace")

            # 1. Semantic OpenGraph article metadata (works on IGN, Medium, Substack, news, blogs)
            if re.search(r'<meta[^>]+property=["\']og:type["\'][^>]+content=["\']article["\']', chunk, re.I) or \
               re.search(r'<meta[^>]+content=["\']article["\'][^>]+property=["\']og:type["\']', chunk, re.I) or \
               re.search(r'<meta[^>]+property=["\']article:(author|published_time|section|tag)["\']', chunk, re.I):
                return "TIER1", "Semantic article metadata detected (og:type=article)"

            # 2. Schema.org JSON-LD article types
            if re.search(r'["\']@type["\']\s*:\s*["\'](Article|NewsArticle|TechArticle|BlogPosting|Guide|HowTo)["\']', chunk, re.I):
                return "TIER1", "JSON-LD Article/Guide schema detected"

            # 3. Path/subdomain article with meta description
            if is_path_article or is_subdomain_doc:
                meta_desc = re.search(r'<meta[^>]+name=["\']description["\'][^>]+content=["\']([^"\']{60,})["\']', chunk, re.I)
                if meta_desc:
                    return "TIER1", f"Article path/subdomain with description ({len(meta_desc.group(1))} chars)"

            # 4. SPA container check (only if not an article)
            spa_markers = [
                (r'<div[^>]+id=["\']root["\']>\s*</div>', "Empty SPA root container (#root)"),
                (r'<div[^>]+id=["\']app["\']>\s*</div>', "Empty SPA app container (#app)"),
                (r'<div[^>]+id=["\']__next["\']>\s*</div>', "Empty Next.js client mount container"),
                (r'<div[^>]+id=["\']__nuxt["\']>\s*</div>', "Empty Nuxt client mount container"),
                (r'<noscript>[^<]*enable JavaScript', "Mandatory JavaScript requirement notice"),
                (r'<app-root>\s*</app-root>', "Angular client app-root")
            ]
            for pattern, label in spa_markers:
                if re.search(pattern, chunk, re.IGNORECASE):
                    return "TIER3", f"SPA marker detected: {label}"

            # 5. Semantic text length in body elements
            p_text = "".join(re.findall(r'<p[^>]*>(.*?)</p>', chunk, re.DOTALL | re.IGNORECASE))
            article_text = "".join(re.findall(r'<article[^>]*>(.*?)</article>', chunk, re.DOTALL | re.IGNORECASE))
            main_text = "".join(re.findall(r'<main[^>]*>(.*?)</main>', chunk, re.DOTALL | re.IGNORECASE))
            combined_text = re.sub(r'<[^>]+>', '', p_text + article_text + main_text).strip()

            if len(combined_text) >= 350:
                return "TIER1", f"Substantial semantic prose ({len(combined_text)} characters in initial stream)"
            else:
                return "TIER3", f"Sparse initial text ({len(combined_text)} chars); likely app UI or dynamic dashboard"

    except Exception as e:
        return "TIER3", f"Probe error or timeout: {e}"


def is_tier2_media(url: str):
    p = urllib.parse.urlparse(url)
    h = p.netloc.lower()
    path = p.path.lower()
    if "youtu.be" in h and len(path) > 1:
        return "YouTube short link"
    if "youtube.com" in h and path.startswith(("/watch", "/shorts/", "/live/", "/embed/")):
        return "YouTube video/stream"
    if "youtube.com" in h:
        return "YouTube portal / search"
    if any(v in h for v in ("twitch.tv", "vimeo.com", "odysee.com", "bilibili.com")) and len(path.strip("/")) > 0:
        return f"Stream media host: {h}"
    if path.endswith((".mp4", ".webm", ".mkv", ".m3u8")):
        return "Direct video media file"
    return None


def classify_tier(url: str, probe: bool = True):
    if not re.match(r"^https?://", url):
        url = "https://" + url

    t1_rules, t2_rules, t3_rules = load_rules()

    r2 = matches_rule(url, t2_rules)
    if r2:
        return "TIER2", f"Matched [TIER2_ONLY] rule: {r2}"

    media_reason = is_tier2_media(url)
    if media_reason:
        return "TIER2", f"Matched media pattern: {media_reason}"

    r1 = matches_rule(url, t1_rules)
    if r1:
        return "TIER1", f"Matched [TIER1_ONLY] rule: {r1}"

    r3 = matches_rule(url, t3_rules)
    if r3:
        return "TIER3", f"Matched [TIER3_ONLY] rule: {r3}"

    if probe:
        return probe_url(url)
    return "TIER3", "Default fallback"


def main():
    parser = argparse.ArgumentParser(description="Webflow Tier Classifier (TIER1 vs TIER3)")
    parser.add_argument("url", help="Target URL to inspect")
    parser.add_argument("-v", "--verbose", action="store_true", help="Print classification reason")
    parser.add_argument("--no-probe", action="store_true", help="Only check config rules, skip network probe")
    args = parser.parse_args()

    tier, reason = classify_tier(args.url.strip(), probe=not args.no_probe)

    if args.verbose:
        print(f"Target: {args.url}")
        print(f"Tier:   {tier}")
        print(f"Reason: {reason}")
    else:
        print(tier)


if __name__ == "__main__":
    main()
