#!/usr/bin/env python3
"""
webflow - Terminal-First Yazi-Style Browser Dashboard & Ephemeral Search Engine
Zero-engine, keyboard-driven 3-pane TUI for ephemeral search, project workbenches, and deliberate memory.
"""
import os
import sys
import re
import json
import time
import curses
import urllib.parse
import urllib.request
import shutil
import subprocess
from pathlib import Path

BASE_DIR = Path.home() / ".local" / "share" / "webflow"
WORKBENCHES_DIR = BASE_DIR / "workbenches"
HISTORY_JSONL = BASE_DIR / "history.jsonl"
BOOKMARKS_FILE = BASE_DIR / "bookmarks.txt"
BIN_DIR = Path(__file__).resolve().parent
REPO_ROOT = BIN_DIR.parent
sys.path.insert(0, str(REPO_ROOT))
from lib.vault import WebflowVault, extract_domain_parts
from lib.theme import (
    PAIR_HEADER, PAIR_TIER1, PAIR_TIER2, PAIR_TIER3, PAIR_SELECTED,
    PAIR_BORDER, PAIR_BORDER_ACTIVE, PAIR_TEXT, PAIR_DIM,
    PAIR_PILL_NORMAL, PAIR_PILL_SEARCH, load_theme_config, init_curses_theme
)


def ensure_dirs():
    BASE_DIR.mkdir(parents=True, exist_ok=True)
    WORKBENCHES_DIR.mkdir(parents=True, exist_ok=True)


def load_routing_rules():
    config_paths = [
        BIN_DIR.parent / "config" / "rules.conf",
        Path.home() / ".config" / "webflow" / "rules.conf"
    ]
    t1, t2, t3 = [], [], []
    for path in config_paths:
        if path.exists():
            sec = None
            try:
                for line in path.read_text(encoding="utf-8").splitlines():
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if line == "[TIER1_ONLY]":
                        sec = "T1"
                        continue
                    elif line == "[TIER2_ONLY]":
                        sec = "T2"
                        continue
                    elif line == "[TIER3_ONLY]":
                        sec = "T3"
                        continue
                    if sec == "T1" and line not in t1:
                        t1.append(line)
                    elif sec == "T2" and line not in t2:
                        t2.append(line)
                    elif sec == "T3" and line not in t3:
                        t3.append(line)
            except Exception:
                pass
    return t1, t2, t3


TIER1_RULES, TIER2_RULES, TIER3_RULES = load_routing_rules()


def is_media_url(url: str) -> bool:
    parsed = urllib.parse.urlparse(url)
    host = parsed.netloc.lower()
    path = parsed.path.lower()
    if "youtu.be" in host and len(path) > 1:
        return True
    if "youtube.com" in host:
        return True
    if any(h in host for h in ("twitch.tv", "vimeo.com", "odysee.com", "bilibili.com")):
        return True
    if path.endswith((".mp4", ".webm", ".mkv", ".m3u8")):
        return True
    return False


def predict_tier(url: str) -> str:
    parsed = urllib.parse.urlparse(url)
    target = f"{parsed.netloc}{parsed.path}"
    for r in TIER2_RULES:
        if r in target or re.search(r, target, re.IGNORECASE):
            return "TIER2 (Media/mpv)"
    if is_media_url(url):
        return "TIER2 (Media/mpv)"
    for r in TIER1_RULES:
        if r in target or re.search(r, target, re.IGNORECASE):
            return "TIER1 (Rule)"
    for r in TIER3_RULES:
        if r in target or re.search(r, target, re.IGNORECASE):
            return "TIER3 (Rule)"
    if any(k in url.lower() for k in ["wiki", "blog", "news", "article", "doc", "text"]):
        return "TIER1 (Heuristic)"
    return "TIER3 (WebKitGTK)"


def fetch_search(query: str):
    query = query.strip()
    if not query:
        return []

    import html as html_module
    results = []

    # 1. Direct URL detection
    direct_url = None
    if " " not in query:
        if query.startswith(("http://", "https://")):
            direct_url = query
        elif "." in query and not query.endswith("."):
            parts = query.split("/")
            domain = parts[0]
            if "." in domain and len(domain.split(".")[-1]) >= 2:
                direct_url = "https://" + query

    if direct_url:
        results.append({
            "title": f"➜ Direct: {direct_url}",
            "url": direct_url,
            "snippet": f"Open {direct_url} directly via dispatcher",
            "domain": urllib.parse.urlparse(direct_url).netloc
        })

    # 2. Primary Web Search: DuckDuckGo Lite via POST
    try:
        headers = {
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0",
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Referer": "https://lite.duckduckgo.com/",
            "Origin": "https://lite.duckduckgo.com",
            "Content-Type": "application/x-www-form-urlencoded"
        }
        data = urllib.parse.urlencode({"q": query}).encode("utf-8")
        req = urllib.request.Request("https://lite.duckduckgo.com/lite/", data=data, headers=headers)
        with urllib.request.urlopen(req, timeout=5) as resp:
            content = resp.read().decode("utf-8", errors="replace")

        links = re.findall(r'<a[^>]+href=[\'\"](https?://[^\'\"]+)[\'\"][^>]*class=[\'\"]result-link[\'\"][^>]*>(.*?)</a>', content)
        snippets = re.findall(r'<td class=[\'\"]result-snippet[\'\"]>(.*?)</td>', content, re.DOTALL)

        for i, (u, raw_t) in enumerate(links[:25]):
            t = html_module.unescape(re.sub(r'<[^>]+>', '', raw_t)).strip()
            s = html_module.unescape(re.sub(r'<[^>]+>', '', snippets[i])).strip() if i < len(snippets) else ''
            s = " ".join(s.split())
            results.append({
                "title": t,
                "url": u,
                "snippet": s,
                "domain": urllib.parse.urlparse(u).netloc
            })
    except Exception:
        pass

    # 3. Fallback Tier 1: DuckDuckGo Instant Answer API
    if len(results) <= (1 if direct_url else 0):
        try:
            api_url = "https://api.duckduckgo.com/?q=" + urllib.parse.quote(query) + "&format=json&no_html=1"
            req = urllib.request.Request(api_url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=4) as resp:
                d = json.loads(resp.read().decode("utf-8"))
                if d.get("AbstractURL"):
                    results.append({
                        "title": d.get("Heading") or query,
                        "url": d.get("AbstractURL"),
                        "snippet": d.get("AbstractText", ""),
                        "domain": urllib.parse.urlparse(d.get("AbstractURL")).netloc
                    })
                for t in d.get("RelatedTopics", []):
                    if "FirstURL" in t:
                        results.append({
                            "title": t.get("Text", "")[:60],
                            "url": t.get("FirstURL"),
                            "snippet": t.get("Text", ""),
                            "domain": urllib.parse.urlparse(t.get("FirstURL")).netloc
                        })
        except Exception:
            pass

    # 4. Fallback Tier 2: Wikipedia OpenSearch API
    if len(results) <= (1 if direct_url else 0):
        try:
            wiki_url = f"https://en.wikipedia.org/w/api.php?action=opensearch&search={urllib.parse.quote(query)}&limit=10&namespace=0&format=json"
            req = urllib.request.Request(wiki_url, headers={"User-Agent": "Webflow/0.2"})
            with urllib.request.urlopen(req, timeout=4) as resp:
                w_data = json.loads(resp.read().decode("utf-8"))
                if len(w_data) >= 4:
                    titles, snips, urls = w_data[1], w_data[2], w_data[3]
                    for i in range(len(titles)):
                        results.append({
                            "title": titles[i],
                            "url": urls[i],
                            "snippet": snips[i] if i < len(snips) else "",
                            "domain": "en.wikipedia.org"
                        })
        except Exception:
            pass

    return results


def load_workbenches():
    ensure_dirs()
    benches = []
    for f in sorted(WORKBENCHES_DIR.glob("*.json")):
        try:
            d = json.loads(f.read_text(encoding="utf-8"))
            benches.append({
                "id": f.stem,
                "name": d.get("name", f.stem),
                "tabs": d.get("tabs", []),
                "updated_at": d.get("updated_at", "")
            })
        except Exception:
            continue
    return benches


def load_history():
    """
    Loads history and deduplicates consecutive or same-day identical URLs,
    tracking visit counts and organizing chronologically.
    """
    ensure_dirs()
    if not HISTORY_JSONL.exists():
        return []
    raw_entries = []
    try:
        lines = HISTORY_JSONL.read_text(encoding="utf-8").splitlines()
        for line in reversed(lines):
            line = line.strip()
            if line:
                raw_entries.append(json.loads(line))
    except Exception:
        pass

    # Group / deduplicate by (date, url) so repeated opens become a clean '×N' badge
    deduped = []
    seen_map = {}
    for entry in raw_entries:
        url = entry.get("url", "").rstrip("/")
        date_str = entry.get("date") or entry.get("timestamp", "")[:10]
        key = (date_str, url)
        if key in seen_map:
            seen_map[key]["count"] += 1
            # Prefer a rich title over a bare domain name
            cur_title = seen_map[key].get("title", "")
            new_title = entry.get("title", "")
            if (not cur_title or cur_title == seen_map[key].get("domain")) and new_title:
                seen_map[key]["title"] = new_title
        else:
            item = dict(entry)
            item["date"] = date_str
            item["count"] = 1
            seen_map[key] = item
            deduped.append(item)

    return deduped[:100]


def load_bookmarks():
    ensure_dirs()
    if not BOOKMARKS_FILE.exists():
        return []
    bms = []
    try:
        lines = BOOKMARKS_FILE.read_text(encoding="utf-8").splitlines()
        for line in reversed(lines):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = [p.strip() for p in line.split("|")]
            if len(parts) >= 2:
                bms.append({
                    "url": parts[0],
                    "title": parts[1],
                    "tag": parts[2] if len(parts) > 2 else "general"
                })
    except Exception:
        pass
    return bms


class WebflowTUI:
    def set_cursor(self, visibility: int):
        try:
            curses.curs_set(visibility)
        except curses.error:
            pass

    def __init__(self, stdscr):
        self.stdscr = stdscr
        self.set_cursor(0)
        self.theme = load_theme_config()
        self.has_colors = init_curses_theme(self.theme)

        self.orig_color_pair = curses.color_pair
        curses.color_pair = lambda n: self.orig_color_pair(n) if self.has_colors else 0

        self.nav_items = [
            ("⚡ Ephemeral Search", "search"),
            ("🗂 Workbenches", "workbenches"),
            ("➕ New Workbench", "new_bench"),
            ("📅 History (Grouped)", "history"),
            ("🔖 Bookmarks (Deliberate)", "bookmarks")
        ]
        self.active_pane = 0
        self.nav_idx = 0
        self.list_idx = 0
        self.search_query = ""
        self.search_results = []
        self.is_searching = False

        # Workbench modal picker state
        self.wb_picker_active = False
        self.wb_picker_idx = 0
        self.wb_picker_url = None
        self.wb_picker_title = ""

        # Sovereign Credential Vault
        self.vault = WebflowVault()

        self.status_msg = "/ Search  |  Enter Open  |  v GUI  |  w Bench  |  y Yank  |  x Delete  |  q Quit"

        self.workbenches = load_workbenches()
        self.history = load_history()
        self.bookmarks = load_bookmarks()

    def run(self):
        self.stdscr.nodelay(False)
        self.stdscr.keypad(True)
        while True:
            self.draw()
            key = self.stdscr.getch()
            if key in [ord('q'), ord('Q')] and not self.is_searching and not self.wb_picker_active:
                break
            self.handle_input(key)

    def safe_addstr(self, y, x, text, attr=0):
        try:
            h, w = self.stdscr.getmaxyx()
            if y < 0 or y >= h or x < 0 or x >= w:
                return
            max_len = w - x
            if y == h - 1:
                max_len = max(0, w - x - 1)
            if max_len <= 0:
                return
            trimmed = str(text)[:max_len]
            if attr:
                self.stdscr.addstr(y, x, trimmed, attr)
            else:
                self.stdscr.addstr(y, x, trimmed)
        except curses.error:
            pass

    def draw(self):
        self.stdscr.erase()
        h, w = self.stdscr.getmaxyx()
        if h < 14 or w < 65:
            self.safe_addstr(0, 0, "Terminal window too small for 3-pane layout.")
            self.stdscr.refresh()
            return

        # 1. Header Banner
        title_bar = " 🌐 Webflow 0.3 — Sovereign Terminal-First Web Architecture "
        self.safe_addstr(0, 0, title_bar[:w - 1].ljust(w - 1), curses.color_pair(PAIR_HEADER) | curses.A_BOLD)

        # 2. Dimensions & Ratios
        r_nav = self.theme["layout"].get("ratio_nav", 0.20)
        r_mid = self.theme["layout"].get("ratio_mid", 0.48)
        col1_w = max(22, int(w * r_nav))
        col2_w = max(30, int(w * r_mid))
        col3_w = (w - 1) - col1_w - col2_w

        grid_y = 1
        grid_h = h - 2
        content_h = grid_h - 2

        current_section = self.nav_items[self.nav_idx][1]
        titles = [
            "1. Sections",
            f"2. {self.nav_items[self.nav_idx][0]}",
            "3. Live Preview & Route"
        ]

        # 3. Draw Unified Outer Frame & Vertical Dividers
        self.draw_unified_grid(grid_y, grid_h, w, col1_w, col2_w, col3_w, titles)

        # 4. Column 1: Navigation
        for idx, (label, tag) in enumerate(self.nav_items):
            y = grid_y + 2 + idx * 2
            if y < grid_y + grid_h - 1:
                prefix = " ❯ " if idx == self.nav_idx else "   "
                text = f"{prefix}{label}"
                inner_w = col1_w - 1
                if idx == self.nav_idx:
                    self.safe_addstr(y, 1, text.ljust(inner_w)[:inner_w], curses.color_pair(PAIR_SELECTED) | curses.A_BOLD)
                else:
                    self.safe_addstr(y, 1, text.ljust(inner_w)[:inner_w], curses.color_pair(PAIR_TEXT))

        # Column 2: Active Middle Pane
        c2_x = col1_w + 1
        c2_w = col2_w - 1
        if current_section == "search":
            self.draw_search_pane(grid_y + 1, c2_x, content_h, c2_w)
        elif current_section == "workbenches":
            self.draw_workbenches_pane(grid_y + 1, c2_x, content_h, c2_w)
        elif current_section == "new_bench":
            self.draw_new_bench_pane(grid_y + 1, c2_x, content_h, c2_w)
        elif current_section == "history":
            self.draw_history_pane(grid_y + 1, c2_x, content_h, c2_w)
        elif current_section == "bookmarks":
            self.draw_bookmarks_pane(grid_y + 1, c2_x, content_h, c2_w)

        # Column 3: Live Preview Panel
        c3_x = col1_w + col2_w + 1
        c3_w = col3_w - 1
        self.draw_preview_pane(grid_y + 1, c3_x, content_h, c3_w, current_section)

        # 5. Modal Workbench Picker Overlay (if active)
        if self.wb_picker_active:
            self.draw_workbench_picker_modal(h, w)

        # 6. Bottom Pill Status Line (Yazi Aesthetic)
        self.draw_bottom_status_bar(h, w)

        self.stdscr.refresh()

    def draw_unified_grid(self, y, h, w, col1_w, col2_w, col3_w, titles):
        x0 = 0
        x1 = col1_w
        x2 = col1_w + col2_w
        x3 = w - 1

        b_color = curses.color_pair(PAIR_BORDER)

        # Top border: ╭───┬───┬───╮
        top_chars = ["─"] * w
        top_chars[x0] = "╭"
        if x1 < w:
            top_chars[x1] = "┬"
        if x2 < w:
            top_chars[x2] = "┬"
        if x3 < w:
            top_chars[x3] = "╮"
        self.safe_addstr(y, 0, "".join(top_chars[:w]), b_color)

        # Column titles along the top border
        col_xs = [x0 + 2, x1 + 2, x2 + 2]
        col_max_ws = [col1_w - 4, col2_w - 4, col3_w - 4]
        for c_idx in range(3):
            if c_idx < len(titles):
                title_str = f" {titles[c_idx].strip()} "
                max_w = col_max_ws[c_idx]
                if max_w > 4:
                    truncated = title_str[:max_w]
                    t_attr = (curses.color_pair(PAIR_BORDER_ACTIVE) | curses.A_BOLD) if c_idx == self.active_pane else b_color
                    self.safe_addstr(y, col_xs[c_idx], truncated, t_attr)

        # Interior vertical dividers: │   │   │   │
        for row in range(y + 1, y + h - 1):
            self.safe_addstr(row, x0, "│", b_color)
            if x1 < w:
                self.safe_addstr(row, x1, "│", b_color)
            if x2 < w:
                self.safe_addstr(row, x2, "│", b_color)
            if x3 < w:
                self.safe_addstr(row, x3, "│", b_color)

        # Bottom border: ╰───┴───┴───╯
        bot_chars = ["─"] * w
        bot_chars[x0] = "╰"
        if x1 < w:
            bot_chars[x1] = "┴"
        if x2 < w:
            bot_chars[x2] = "┴"
        if x3 < w:
            bot_chars[x3] = "╯"
        self.safe_addstr(y + h - 1, 0, "".join(bot_chars[:w]), b_color)

    def draw_bottom_status_bar(self, h, w):
        by = h - 1
        # Clear bottom line
        self.safe_addstr(by, 0, " " * (w - 1), curses.color_pair(PAIR_BORDER))

        # 1. Left Pill: [ NORMAL ] or [ SEARCH ]
        if self.is_searching:
            pill = " SEARCH "
            pill_attr = curses.color_pair(PAIR_PILL_SEARCH) | curses.A_BOLD
        else:
            pill = " NORMAL "
            pill_attr = curses.color_pair(PAIR_PILL_NORMAL) | curses.A_BOLD

        self.safe_addstr(by, 0, pill, pill_attr)
        px = len(pill) + 1

        # 2. Main Status or Search Buffer
        if self.is_searching:
            msg = f"/{self.search_query}"
        else:
            msg = self.status_msg

        # Reserve space for right-side pills
        cur_len = self.get_current_list_len()
        pos_str = f"[{self.list_idx + 1}/{cur_len}]" if cur_len > 0 else "[--]"
        pane_names = ["NAV", "LIST", "PREVIEW"]
        active_pane_str = pane_names[self.active_pane]
        sec_name = self.nav_items[self.nav_idx][1].upper()
        right_pill = f" {pos_str}  [{active_pane_str}:{sec_name}] "

        max_msg_w = max(0, w - px - len(right_pill) - 2)
        self.safe_addstr(by, px, msg[:max_msg_w], curses.color_pair(PAIR_TEXT))

        # 3. Right Pill
        rx = max(px + len(msg[:max_msg_w]), w - len(right_pill) - 1)
        self.safe_addstr(by, rx, right_pill, curses.color_pair(PAIR_HEADER) | curses.A_BOLD)

    def get_visible_slice(self, items, selected_idx, max_rows):
        if not items or max_rows <= 0:
            return [], 0
        total = len(items)
        if total <= max_rows:
            return [(i, items[i]) for i in range(total)], 0
        half = max_rows // 2
        start = max(0, min(selected_idx - half, total - max_rows))
        end = start + max_rows
        return [(i, items[i]) for i in range(start, end)], start

    def draw_box(self, y, x, h, w, title="", is_active=False, fill=False):
        color = (curses.color_pair(PAIR_BORDER_ACTIVE) | curses.A_BOLD) if is_active else curses.color_pair(PAIR_BORDER)
        self.safe_addstr(y, x, "╭" + "─" * (w - 2) + "╮", color)
        for i in range(1, h - 1):
            if fill:
                self.safe_addstr(y + i, x, "│" + (" " * (w - 2)) + "│", curses.color_pair(PAIR_HEADER))
            else:
                self.safe_addstr(y + i, x, "│", color)
                self.safe_addstr(y + i, x + w - 1, "│", color)
        self.safe_addstr(y + h - 1, x, "╰" + "─" * (w - 2) + "╯", color)
        if title:
            t = f" {title.strip()} "
            if len(t) < w - 4:
                self.safe_addstr(y, x + 2, t, color)

    def draw_search_pane(self, py, px, ph, pw):
        # Framed Search Input Box (3 rows tall)
        s_color = (curses.color_pair(PAIR_BORDER_ACTIVE) | curses.A_BOLD) if self.is_searching else curses.color_pair(PAIR_BORDER)
        box_w = max(10, pw - 4)
        self.safe_addstr(py + 1, px + 2, "╭" + "─" * (box_w - 2) + "╮", s_color)
        cursor_char = "█" if self.is_searching else ""
        prompt_str = f" 🔍 {self.search_query}{cursor_char}" if (self.search_query or self.is_searching) else " 🔍 Press [/] to search DuckDuckGo / Wikipedia / Direct URL..."
        self.safe_addstr(py + 2, px + 2, "│" + prompt_str[:box_w - 2].ljust(box_w - 2) + "│", s_color)
        self.safe_addstr(py + 3, px + 2, "╰" + "─" * (box_w - 2) + "╯", s_color)

        if not self.search_results:
            self.safe_addstr(py + 5, px + 3, "No active search results.", curses.color_pair(PAIR_TIER2))
            self.safe_addstr(py + 7, px + 3, "Tips:", curses.color_pair(PAIR_HEADER) | curses.A_BOLD)
            self.safe_addstr(py + 8, px + 3, "• Press [/] to type query or domain (e.g. archlinux.org)", curses.color_pair(PAIR_TEXT))
            self.safe_addstr(py + 9, px + 3, "• Press [Enter] to open, [v] WebKit GUI, [r] Reader, [m] Media", curses.color_pair(PAIR_TEXT))
            self.safe_addstr(py + 10, px + 3, "• Press [w] to assign to Workbench, [y] to yank URL", curses.color_pair(PAIR_TEXT))
            return

        avail_h = ph - 5
        cards_per_page = max(1, avail_h // 2)
        visible_items, _ = self.get_visible_slice(self.search_results, self.list_idx, cards_per_page)
        show_rel = self.theme["layout"].get("show_relative_numbers", True)

        for card_offset, (real_idx, item) in enumerate(visible_items):
            y1 = py + 4 + (card_offset * 2)
            y2 = y1 + 1
            if y2 >= py + ph:
                break

            is_sel = (real_idx == self.list_idx) and (self.active_pane == 1)
            url = item.get("url", "")
            domain = item.get("domain", "")
            snippet = item.get("snippet", "")
            pred = predict_tier(url)
            if "TIER2" in pred:
                tier_badge = "[T2]"
                t_color = curses.color_pair(PAIR_TIER2) | curses.A_BOLD
            elif "TIER1" in pred:
                tier_badge = "[T1]"
                t_color = curses.color_pair(PAIR_TIER1) | curses.A_BOLD
            else:
                tier_badge = "[T3]"
                t_color = curses.color_pair(PAIR_TIER3) | curses.A_BOLD

            if show_rel and self.active_pane == 1:
                if real_idx == self.list_idx:
                    num_prefix = f" > {real_idx + 1:2d} "
                else:
                    dist = abs(real_idx - self.list_idx)
                    num_prefix = f"   {dist:2d} "
            else:
                num_prefix = f" {real_idx + 1:2d}. "

            title_part = f"{item.get('title', '')}"
            badge_str = f" {tier_badge} "
            card_w = pw - 2
            max_title_w = max(10, card_w - len(num_prefix) - len(badge_str))
            line1_raw = f"{num_prefix}{title_part[:max_title_w].ljust(max_title_w)}{badge_str}"
            sub_text = f"       🌐 {domain} — {snippet}" if snippet else f"       🌐 {url}"

            if is_sel:
                self.safe_addstr(y1, px + 1, line1_raw[:card_w].ljust(card_w), curses.color_pair(PAIR_SELECTED) | curses.A_BOLD)
                self.safe_addstr(y2, px + 1, sub_text[:card_w].ljust(card_w), curses.color_pair(PAIR_SELECTED))
            else:
                self.safe_addstr(y1, px + 1, num_prefix, curses.color_pair(PAIR_DIM))
                self.safe_addstr(y1, px + 1 + len(num_prefix), title_part[:max_title_w], curses.color_pair(PAIR_TEXT) | curses.A_BOLD)
                self.safe_addstr(y1, px + 1 + len(num_prefix) + max_title_w, badge_str, t_color)
                self.safe_addstr(y2, px + 1, sub_text[:card_w], curses.color_pair(PAIR_DIM))

    def draw_workbenches_pane(self, py, px, ph, pw):
        if not self.workbenches:
            self.safe_addstr(py + 3, px + 3, "No workbenches saved yet.", curses.color_pair(PAIR_TIER2))
            self.safe_addstr(py + 5, px + 3, "Press [w] on any search/history item or select ➕ New Workbench.", curses.color_pair(PAIR_TEXT))
            return

        self.safe_addstr(py + 1, px + 2, "Saved Workbenches  ([Enter] Open  [x] Delete)", curses.color_pair(PAIR_DIM))

        max_rows = ph - 3
        visible_items, _ = self.get_visible_slice(self.workbenches, self.list_idx, max_rows)
        show_rel = self.theme["layout"].get("show_relative_numbers", True)

        for row_offset, (real_idx, b) in enumerate(visible_items):
            y = py + 2 + row_offset
            if y >= py + ph:
                break
            is_sel = (real_idx == self.list_idx) and (self.active_pane == 1)
            tab_count = len(b.get("tabs", []))
            updated = b.get("updated_at", "")[:16]

            if show_rel and self.active_pane == 1:
                if real_idx == self.list_idx:
                    num_prefix = f" > {real_idx + 1:2d} "
                else:
                    dist = abs(real_idx - self.list_idx)
                    num_prefix = f"   {dist:2d} "
            else:
                num_prefix = f" {real_idx + 1:2d}. "

            row_w = pw - 2
            line_full = f"{num_prefix}🗂  {b.get('name'):<20} [{tab_count:2d} tabs]   {updated}"

            if is_sel:
                self.safe_addstr(y, px + 1, line_full[:row_w].ljust(row_w), curses.color_pair(PAIR_SELECTED) | curses.A_BOLD)
            else:
                self.safe_addstr(y, px + 1, num_prefix, curses.color_pair(PAIR_DIM))
                cur_x = px + 1 + len(num_prefix)
                self.safe_addstr(y, cur_x, f"🗂  {b.get('name'):<20} ", curses.color_pair(PAIR_TEXT) | curses.A_BOLD)
                cur_x += 24
                self.safe_addstr(y, cur_x, f"[{tab_count:2d} tabs]   {updated}", curses.color_pair(PAIR_DIM))

    def draw_new_bench_pane(self, py, px, ph, pw):
        self.safe_addstr(py + 3, px + 3, "Create Named Persistent Workbench:", curses.color_pair(PAIR_HEADER) | curses.A_BOLD)
        self.safe_addstr(py + 5, px + 3, "Press [Enter] to name and initialize a new project workbench.", curses.color_pair(PAIR_TEXT))
        self.safe_addstr(py + 7, px + 3, "• Logins & cookies are shared seamlessly per-domain.", curses.color_pair(PAIR_TIER1))
        self.safe_addstr(py + 8, px + 3, "• Tabs automatically update their URLs when you close wf-view.", curses.color_pair(PAIR_TIER1))

    def draw_history_pane(self, py, px, ph, pw):
        if not self.history:
            self.safe_addstr(py + 3, px + 3, "History is currently empty.", curses.color_pair(PAIR_TIER2))
            return

        self.safe_addstr(py + 1, px + 2, "Deduplicated Stream  ([x] Delete  [C] Clear  [y] Yank)", curses.color_pair(PAIR_DIM))

        max_rows = ph - 3
        visible_items, _ = self.get_visible_slice(self.history, self.list_idx, max_rows)
        today_str = time.strftime("%Y-%m-%d")
        show_rel = self.theme["layout"].get("show_relative_numbers", True)

        for row_offset, (real_idx, entry) in enumerate(visible_items):
            y = py + 2 + row_offset
            if y >= py + ph:
                break
            is_sel = (real_idx == self.list_idx) and (self.active_pane == 1)
            date_str = entry.get("date", "")
            date_tag = "Today" if date_str == today_str else date_str[5:]
            t_str = entry.get("time", entry.get("timestamp", ""))[:5]
            tier = "T1" if "1" in entry.get("tier", "") else "T3"
            count = entry.get("count", 1)
            count_badge = f"×{count} " if count > 1 else "   "
            title = entry.get("title") or entry.get("domain") or entry.get("url", "")
            domain = entry.get("domain", "")
            display_title = f"{title} ({domain})" if (title != domain and domain) else title

            if show_rel and self.active_pane == 1:
                if real_idx == self.list_idx:
                    num_prefix = f" > {real_idx + 1:2d} "
                else:
                    dist = abs(real_idx - self.list_idx)
                    num_prefix = f"   {dist:2d} "
            else:
                num_prefix = f" {real_idx + 1:2d}. "

            row_w = pw - 2
            line_full = f"{num_prefix}{date_tag:<5} {t_str} [{tier}] {count_badge}{display_title}"

            if is_sel:
                self.safe_addstr(y, px + 1, line_full[:row_w].ljust(row_w), curses.color_pair(PAIR_SELECTED) | curses.A_BOLD)
            else:
                self.safe_addstr(y, px + 1, num_prefix, curses.color_pair(PAIR_DIM))
                cur_x = px + 1 + len(num_prefix)
                self.safe_addstr(y, cur_x, f"{date_tag:<5} {t_str} ", curses.color_pair(PAIR_DIM))
                cur_x += 12
                t_col = curses.color_pair(PAIR_TIER1) if tier == "T1" else curses.color_pair(PAIR_TIER3)
                self.safe_addstr(y, cur_x, f"[{tier}] ", t_col)
                cur_x += 5
                if count > 1:
                    self.safe_addstr(y, cur_x, f"{count_badge}", curses.color_pair(PAIR_HEADER) | curses.A_BOLD)
                cur_x += len(count_badge)
                avail_t = max(0, px + row_w - cur_x)
                self.safe_addstr(y, cur_x, display_title[:avail_t], curses.color_pair(PAIR_TEXT))

    def draw_bookmarks_pane(self, py, px, ph, pw):
        if not self.bookmarks:
            self.safe_addstr(py + 3, px + 3, "No deliberate bookmarks found.", curses.color_pair(PAIR_TIER2))
            return

        self.safe_addstr(py + 1, px + 2, "Deliberate Bookmarks  ([x] Delete  [b] Add  [y] Yank)", curses.color_pair(PAIR_DIM))

        max_rows = ph - 3
        visible_items, _ = self.get_visible_slice(self.bookmarks, self.list_idx, max_rows)
        show_rel = self.theme["layout"].get("show_relative_numbers", True)

        for row_offset, (real_idx, bm) in enumerate(visible_items):
            y = py + 2 + row_offset
            if y >= py + ph:
                break
            is_sel = (real_idx == self.list_idx) and (self.active_pane == 1)
            tag = bm.get("tag", "general")
            title = bm.get("title", bm.get("url", ""))

            if show_rel and self.active_pane == 1:
                if real_idx == self.list_idx:
                    num_prefix = f" > {real_idx + 1:2d} "
                else:
                    dist = abs(real_idx - self.list_idx)
                    num_prefix = f"   {dist:2d} "
            else:
                num_prefix = f" {real_idx + 1:2d}. "

            row_w = pw - 2
            line_full = f"{num_prefix}[{tag}] {title}"

            if is_sel:
                self.safe_addstr(y, px + 1, line_full[:row_w].ljust(row_w), curses.color_pair(PAIR_SELECTED) | curses.A_BOLD)
            else:
                self.safe_addstr(y, px + 1, num_prefix, curses.color_pair(PAIR_DIM))
                cur_x = px + 1 + len(num_prefix)
                self.safe_addstr(y, cur_x, f"[{tag}] ", curses.color_pair(PAIR_HEADER) | curses.A_BOLD)
                cur_x += len(tag) + 3
                avail_t = max(0, px + row_w - cur_x)
                self.safe_addstr(y, cur_x, title[:avail_t], curses.color_pair(PAIR_TEXT))

    def draw_preview_pane(self, py, px, ph, pw, section):
        if section == "search" and self.search_results and self.list_idx < len(self.search_results):
            sel_item = self.search_results[self.list_idx]
            title = sel_item.get("title", "")
            url = sel_item.get("url", "")
            snippet = sel_item.get("snippet", "")
            tier = predict_tier(url)

            self.safe_addstr(py + 2, px + 2, "Title:", curses.color_pair(PAIR_HEADER) | curses.A_BOLD)
            self.safe_addstr(py + 3, px + 2, title[:pw - 4], curses.color_pair(PAIR_TEXT) | curses.A_BOLD)
            self.safe_addstr(py + 5, px + 2, "URL:", curses.color_pair(PAIR_HEADER) | curses.A_BOLD)
            self.safe_addstr(py + 6, px + 2, url[:pw - 4], curses.color_pair(PAIR_TIER1))
            self.safe_addstr(py + 8, px + 2, "Target Route:", curses.color_pair(PAIR_HEADER) | curses.A_BOLD)
            self.safe_addstr(py + 9, px + 2, tier[:pw - 4], curses.color_pair(PAIR_TIER2))
            self.safe_addstr(py + 11, px + 2, "Snippet:", curses.color_pair(PAIR_HEADER) | curses.A_BOLD)

            words = snippet.split()
            line_y = py + 12
            cur_line = []
            for word in words:
                if len(" ".join(cur_line + [word])) < pw - 4:
                    cur_line.append(word)
                else:
                    if line_y < py + ph - 4:
                        self.safe_addstr(line_y, px + 2, " ".join(cur_line), curses.color_pair(PAIR_TEXT))
                        line_y += 1
                    cur_line = [word]
            if cur_line and line_y < py + ph - 4:
                self.safe_addstr(line_y, px + 2, " ".join(cur_line), curses.color_pair(PAIR_TEXT))

        elif section == "workbenches" and self.workbenches and self.list_idx < len(self.workbenches):
            bench = self.workbenches[self.list_idx]
            self.safe_addstr(py + 2, px + 2, f"Workbench: {bench.get('name')}", curses.color_pair(PAIR_HEADER) | curses.A_BOLD)
            self.safe_addstr(py + 4, px + 2, f"Updated:   {bench.get('updated_at')}", curses.color_pair(PAIR_TEXT))
            self.safe_addstr(py + 6, px + 2, "Persisted Tabs:", curses.color_pair(PAIR_TIER1) | curses.A_BOLD)
            tabs = bench.get("tabs", [])
            for ti, tab in enumerate(tabs[:ph - 10]):
                u = tab.get("url", "")
                t = tab.get("title", u)
                self.safe_addstr(py + 8 + ti, px + 2, f"[{ti+1}] {t[:pw-8]}", curses.color_pair(PAIR_TEXT))

        elif section == "history" and self.history and self.list_idx < len(self.history):
            h_entry = self.history[self.list_idx]
            self.safe_addstr(py + 2, px + 2, "History Entry:", curses.color_pair(PAIR_HEADER) | curses.A_BOLD)
            self.safe_addstr(py + 4, px + 2, f"Title:  {h_entry.get('title', '')[:pw-10]}", curses.color_pair(PAIR_TEXT) | curses.A_BOLD)
            self.safe_addstr(py + 6, px + 2, f"Domain: {h_entry.get('domain', '')[:pw-10]}", curses.color_pair(PAIR_HEADER))
            self.safe_addstr(py + 8, px + 2, f"URL:    {h_entry.get('url', '')[:pw-10]}", curses.color_pair(PAIR_TIER1))
            self.safe_addstr(py + 10, px + 2, f"Last:   {h_entry.get('timestamp', '')}", curses.color_pair(PAIR_TEXT))
            self.safe_addstr(py + 12, px + 2, f"Visits: {h_entry.get('count', 1)} time(s) on this date", curses.color_pair(PAIR_TIER3) | curses.A_BOLD)
            self.safe_addstr(py + 14, px + 2, f"Route:  {h_entry.get('tier', '')}", curses.color_pair(PAIR_TIER2))

            dom = h_entry.get('domain', '')
            creds = self.vault.get_all_for_domain(dom)
            if creds:
                users = ", ".join(c["username"] for c in creds)
                self.safe_addstr(py + 16, px + 2, f"Vault:  🔐 Saved login ({users})"[:pw-4], curses.color_pair(PAIR_TIER1) | curses.A_BOLD)

        elif section == "bookmarks" and self.bookmarks and self.list_idx < len(self.bookmarks):
            bm = self.bookmarks[self.list_idx]
            self.safe_addstr(py + 2, px + 2, f"Tag:   [{bm.get('tag', 'general')}]", curses.color_pair(PAIR_HEADER) | curses.A_BOLD)
            self.safe_addstr(py + 4, px + 2, f"Note:  {bm.get('title', '')[:pw-9]}", curses.color_pair(PAIR_TEXT) | curses.A_BOLD)
            self.safe_addstr(py + 6, px + 2, f"URL:   {bm.get('url', '')[:pw-9]}", curses.color_pair(PAIR_TIER1))

            creds = self.vault.get_all_for_domain(bm.get('url', ''))
            if creds:
                users = ", ".join(c["username"] for c in creds)
                self.safe_addstr(py + 8, px + 2, f"Vault: 🔐 Saved login ({users})"[:pw-4], curses.color_pair(PAIR_TIER1) | curses.A_BOLD)
        else:
            self.safe_addstr(py + 3, px + 3, "Select an item to preview details.", curses.color_pair(PAIR_TEXT))

        self.safe_addstr(py + ph - 3, px + 2, "─" * (pw - 4), curses.color_pair(PAIR_BORDER))
        self.safe_addstr(py + ph - 2, px + 2, "[Enter] Open | [v] GUI | [m] Media | [w] Bench | [y] Yank | [x] Del", curses.color_pair(PAIR_HEADER))

    def draw_workbench_picker_modal(self, h, w):
        options = [b.get("name") for b in self.workbenches] + ["➕ Create New Workbench..."]
        mw = min(56, w - 8)
        mh = min(len(options) + 6, h - 4)
        my = (h - mh) // 2
        mx = (w - mw) // 2

        self.draw_box(my, mx, mh, mw, " 🗂 Save URL to Workbench ", is_active=True, fill=True)
        short_u = (self.wb_picker_url or "")[:mw - 6]
        self.safe_addstr(my + 1, mx + 3, f"Target: {short_u}", curses.color_pair(PAIR_TIER1))
        self.safe_addstr(my + 2, mx + 2, "─" * (mw - 4), curses.color_pair(PAIR_BORDER))

        max_opts = mh - 5
        vis_opts, _ = self.get_visible_slice(options, self.wb_picker_idx, max_opts)
        for row_i, (real_i, opt_name) in enumerate(vis_opts):
            oy = my + 3 + row_i
            is_sel = (real_i == self.wb_picker_idx)
            prefix = " ❯ " if is_sel else "   "
            label = f"{prefix}{opt_name}"
            if is_sel:
                self.safe_addstr(oy, mx + 2, label[:mw - 4].ljust(mw - 4), curses.color_pair(PAIR_SELECTED) | curses.A_BOLD)
            else:
                col = (curses.color_pair(PAIR_TIER2) | curses.A_BOLD) if real_i == len(options) - 1 else curses.color_pair(PAIR_TEXT)
                self.safe_addstr(oy, mx + 2, label[:mw - 4], col)

        self.safe_addstr(my + mh - 2, mx + 3, "[j/k] Select  |  [Enter] Confirm  |  [Esc] Cancel", curses.color_pair(PAIR_HEADER))

    def handle_input(self, key):
        # 1. Modal Workbench Picker Input
        if self.wb_picker_active:
            options_len = len(self.workbenches) + 1
            if key in [27, ord('q'), ord('Q')]:
                self.wb_picker_active = False
                self.status_msg = "Cancelled workbench assignment."
            elif key in [ord('j'), curses.KEY_DOWN]:
                self.wb_picker_idx = (self.wb_picker_idx + 1) % options_len
            elif key in [ord('k'), curses.KEY_UP]:
                self.wb_picker_idx = (self.wb_picker_idx - 1) % options_len
            elif key in [10, 13]:
                self.wb_picker_active = False
                if self.wb_picker_idx < len(self.workbenches):
                    chosen_bench = self.workbenches[self.wb_picker_idx].get("name")
                    wf_bench = BIN_DIR / "wf-workbench"
                    subprocess.run(
                        [str(wf_bench), "add", chosen_bench, self.wb_picker_url, "--title", self.wb_picker_title],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                    )
                    self.workbenches = load_workbenches()
                    self.status_msg = f"[+] Added to workbench '{chosen_bench}'."
                else:
                    # User chose "+ Create New Workbench..."
                    new_name = self.prompt_line_input("New Workbench Name: ")
                    if new_name:
                        wf_bench = BIN_DIR / "wf-workbench"
                        subprocess.run([str(wf_bench), "create", new_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        subprocess.run(
                            [str(wf_bench), "add", new_name, self.wb_picker_url, "--title", self.wb_picker_title],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                        )
                        self.workbenches = load_workbenches()
                        self.status_msg = f"[+] Created workbench '{new_name}' and added URL."
            return

        # 2. Search Bar Input
        if self.is_searching:
            if key in [10, 13]:
                self.is_searching = False
                self.set_cursor(0)
                if self.search_query.strip():
                    self.status_msg = f"Searching for '{self.search_query}'..."
                    self.draw()
                    self.search_results = fetch_search(self.search_query)
                    self.list_idx = 0
                    self.active_pane = 1
                    self.status_msg = f"Found {len(self.search_results)} results for '{self.search_query}'."
            elif key in [27]:
                self.is_searching = False
                self.set_cursor(0)
            elif key in [curses.KEY_BACKSPACE, 127, 8]:
                self.search_query = self.search_query[:-1]
            elif 32 <= key <= 126:
                self.search_query += chr(key)
            return

        if key == ord('/'):
            self.nav_idx = 0
            self.is_searching = True
            self.set_cursor(1)
            self.status_msg = "Type search query or URL and press [Enter]..."
            return

        if key in [ord('l'), ord('\t'), curses.KEY_RIGHT]:
            self.active_pane = min(2, self.active_pane + 1)
        elif key in [ord('h'), curses.KEY_LEFT, curses.KEY_BTAB]:
            self.active_pane = max(0, self.active_pane - 1)
        elif key in [ord('j'), curses.KEY_DOWN]:
            if self.active_pane == 0:
                self.nav_idx = (self.nav_idx + 1) % len(self.nav_items)
                self.list_idx = 0
            elif self.active_pane == 1:
                cur_len = self.get_current_list_len()
                if cur_len > 0:
                    self.list_idx = (self.list_idx + 1) % cur_len
        elif key in [ord('k'), curses.KEY_UP]:
            if self.active_pane == 0:
                self.nav_idx = (self.nav_idx - 1) % len(self.nav_items)
                self.list_idx = 0
            elif self.active_pane == 1:
                cur_len = self.get_current_list_len()
                if cur_len > 0:
                    self.list_idx = (self.list_idx - 1) % cur_len
        elif key in [10, 13]:
            self.execute_selection()
        elif key in [ord('v'), ord('V')]:
            self.execute_selection(force_tier="TIER3")
        elif key in [ord('r'), ord('R')]:
            self.execute_selection(force_tier="TIER1")
        elif key in [ord('m'), ord('M')]:
            self.execute_selection(force_tier="TIER2")
        elif key in [ord('w'), ord('W')]:
            self.open_workbench_picker()
        elif key in [ord('b'), ord('B')]:
            self.prompt_add_bookmark()
        elif key in [ord('y'), ord('Y')]:
            self.yank_selected_url()
        elif key == ord('x'):
            self.delete_selected_item()
        elif key == ord('C'):
            self.clear_history()
        elif key in [ord('P'), ord('p')]:
            self.show_vault_info_for_selected()

    def show_vault_info_for_selected(self):
        target_url, _ = self.get_selected_url_and_title()
        if target_url:
            dom = extract_domain_parts(target_url)[1]
            creds = self.vault.get_all_for_domain(dom)
            if creds:
                users = ", ".join(c["username"] for c in creds)
                self.status_msg = f"🔐 Vault [{dom}]: user '{users}' saved. (CLI: wf-pass get {dom})"
            else:
                self.status_msg = f"[-] No saved login for {dom}. (CLI: wf-pass add {dom} <user>)"
        else:
            self.status_msg = "[*] Webflow Vault active. Use 'wf-pass list' to inspect all accounts."

    def prompt_line_input(self, prompt_label: str, max_chars: int = 45) -> str:
        curses.echo()
        self.set_cursor(1)
        h, w = self.stdscr.getmaxyx()
        self.safe_addstr(h - 2, 2, " " * (w - 4))
        self.safe_addstr(h - 2, 2, prompt_label, curses.color_pair(PAIR_HEADER) | curses.A_BOLD)
        raw_bytes = self.stdscr.getstr(h - 2, 2 + len(prompt_label), max_chars)
        curses.noecho()
        self.set_cursor(0)
        return raw_bytes.decode("utf-8", errors="replace").strip()

    def open_workbench_picker(self):
        target_url, target_title = self.get_selected_url_and_title()
        if not target_url:
            self.status_msg = "[-] Select a search result, history entry, or bookmark first."
            return
        self.workbenches = load_workbenches()
        self.wb_picker_url = target_url
        self.wb_picker_title = target_title
        self.wb_picker_idx = 0
        self.wb_picker_active = True

    def yank_selected_url(self):
        url, _ = self.get_selected_url_and_title()
        if not url:
            self.status_msg = "[-] No URL selected to yank."
            return
        copied = False
        if shutil.which("wl-copy"):
            try:
                subprocess.run(["wl-copy"], input=url.encode("utf-8"), check=True)
                copied = True
            except Exception:
                pass
        if not copied and shutil.which("xclip"):
            try:
                subprocess.run(["xclip", "-selection", "clipboard"], input=url.encode("utf-8"), check=True)
                copied = True
            except Exception:
                pass
        if copied:
            self.status_msg = f"📋 Yanked: {url}"
        else:
            self.status_msg = f"[-] Clipboard tool (wl-copy/xclip) not available."

    def delete_selected_item(self):
        sec = self.nav_items[self.nav_idx][1]
        if sec == "history" and self.history and self.list_idx < len(self.history):
            target = self.history[self.list_idx]
            target_url = target.get("url")
            if HISTORY_JSONL.exists():
                lines = HISTORY_JSONL.read_text(encoding="utf-8").splitlines()
                kept = [l for l in lines if target_url not in l]
                HISTORY_JSONL.write_text("\n".join(kept) + ("\n" if kept else ""), encoding="utf-8")
            self.history = load_history()
            self.list_idx = max(0, min(self.list_idx, len(self.history) - 1))
            self.status_msg = f"[+] Removed '{target_url}' from history."
        elif sec == "bookmarks" and self.bookmarks and self.list_idx < len(self.bookmarks):
            target = self.bookmarks[self.list_idx]
            target_url = target.get("url")
            if BOOKMARKS_FILE.exists():
                lines = BOOKMARKS_FILE.read_text(encoding="utf-8").splitlines()
                kept = []
                for line in lines:
                    parts = [p.strip() for p in line.split("|")]
                    if parts and parts[0] == target_url:
                        continue
                    kept.append(line)
                BOOKMARKS_FILE.write_text("\n".join(kept) + ("\n" if kept else ""), encoding="utf-8")
            self.bookmarks = load_bookmarks()
            self.list_idx = max(0, min(self.list_idx, len(self.bookmarks) - 1))
            self.status_msg = f"[+] Removed bookmark: {target.get('title')}"
        elif sec == "workbenches" and self.workbenches and self.list_idx < len(self.workbenches):
            bench_name = self.workbenches[self.list_idx].get("name")
            safe_wb = "".join(c if c.isalnum() or c in "-_" else "_" for c in bench_name.strip())
            manifest = WORKBENCHES_DIR / f"{safe_wb}.json"
            if manifest.exists():
                manifest.unlink(missing_ok=True)
            self.workbenches = load_workbenches()
            self.list_idx = max(0, min(self.list_idx, len(self.workbenches) - 1))
            self.status_msg = f"[+] Deleted workbench: '{bench_name}'"

    def clear_history(self):
        if self.nav_items[self.nav_idx][1] == "history":
            if HISTORY_JSONL.exists():
                HISTORY_JSONL.write_text("", encoding="utf-8")
            hist_txt = BASE_DIR / "history.txt"
            if hist_txt.exists():
                hist_txt.write_text("", encoding="utf-8")
            self.history = []
            self.list_idx = 0
            self.status_msg = "[+] History cleared."

    def get_current_list_len(self):
        sec = self.nav_items[self.nav_idx][1]
        if sec == "search":
            return len(self.search_results)
        elif sec == "workbenches":
            return len(self.workbenches)
        elif sec == "history":
            return len(self.history)
        elif sec == "bookmarks":
            return len(self.bookmarks)
        return 0

    def launch_external(self, cmd_list, wait=True):
        curses.def_prog_mode()
        curses.endwin()
        try:
            if wait:
                subprocess.run(cmd_list)
            else:
                subprocess.Popen(
                    cmd_list,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True
                )
        finally:
            curses.reset_prog_mode()
            self.stdscr.clear()
            self.stdscr.refresh()
            self.history = load_history()
            self.bookmarks = load_bookmarks()
            self.workbenches = load_workbenches()

    def execute_selection(self, force_tier=None):
        sec = self.nav_items[self.nav_idx][1]
        wf_open = BIN_DIR / "wf-open"
        wf_view = BIN_DIR / "wf-view"
        wf_reader = BIN_DIR / "wf-reader"

        if sec == "workbenches" and self.workbenches and self.list_idx < len(self.workbenches):
            bench_name = self.workbenches[self.list_idx].get("name")
            wf_bench = BIN_DIR / "wf-workbench"
            self.launch_external([str(wf_bench), "open", bench_name], wait=False)
            return
        elif sec == "new_bench":
            name = self.prompt_line_input("Enter New Workbench Name: ")
            if name:
                wf_bench = BIN_DIR / "wf-workbench"
                subprocess.run([str(wf_bench), "create", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.workbenches = load_workbenches()
                self.nav_idx = 1
                self.active_pane = 1
                self.status_msg = f"[+] Workbench '{name}' initialized."
            return

        url, _ = self.get_selected_url_and_title()
        if url:
            if force_tier == "TIER1":
                self.launch_external([str(wf_reader), url], wait=True)
            elif force_tier == "TIER2" or (not force_tier and "TIER2" in predict_tier(url)):
                wf_media = BIN_DIR / "wf-media"
                self.launch_external([str(wf_media), url], wait=False)
            elif force_tier == "TIER3":
                self.launch_external([str(wf_view), url], wait=False)
            else:
                self.launch_external([str(wf_open), url], wait=True)

    def prompt_add_bookmark(self):
        target_url, default_title = self.get_selected_url_and_title()
        if not target_url:
            self.status_msg = "[-] No valid URL selected to bookmark."
            return
        tag = self.prompt_line_input("Deliberate Folder/Tag (default: general): ", 30) or "general"
        title = self.prompt_line_input(f"Custom Note / Title (Enter for '{default_title[:25]}'): ", 50) or default_title
        with open(BOOKMARKS_FILE, "a", encoding="utf-8") as f:
            f.write(f"{target_url} | {title} | {tag}\n")
        self.bookmarks = load_bookmarks()
        self.status_msg = f"[+] Bookmarked in [{tag}]: {title}"

    def get_selected_url_and_title(self):
        sec = self.nav_items[self.nav_idx][1]
        if sec == "search" and self.search_results and self.list_idx < len(self.search_results):
            item = self.search_results[self.list_idx]
            return item.get("url"), item.get("title") or item.get("url")
        elif sec == "history" and self.history and self.list_idx < len(self.history):
            item = self.history[self.list_idx]
            return item.get("url"), item.get("title") or item.get("url")
        elif sec == "bookmarks" and self.bookmarks and self.list_idx < len(self.bookmarks):
            item = self.bookmarks[self.list_idx]
            return item.get("url"), item.get("title") or item.get("url")
        return None, ""


def main():
    try:
        curses.wrapper(lambda stdscr: WebflowTUI(stdscr).run())
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
