#!/usr/bin/env python3
"""
webflow - Terminal-First Yazi-Style Browser Dashboard & Ephemeral Search Engine
Zero-engine, keyboard-driven 3-pane TUI for ephemeral search, project workbenches, and deliberate memory.
"""

import os
import sys
import re
import json
import time
import curses
import urllib.parse
import urllib.request
import subprocess
from pathlib import Path


BASE_DIR = Path.home() / ".local" / "share" / "webflow"
WORKBENCHES_DIR = BASE_DIR / "workbenches"
HISTORY_JSONL = BASE_DIR / "history.jsonl"
BOOKMARKS_FILE = BASE_DIR / "bookmarks.txt"
BIN_DIR = Path(__file__).resolve().parent


def ensure_dirs():
    BASE_DIR.mkdir(parents=True, exist_ok=True)
    WORKBENCHES_DIR.mkdir(parents=True, exist_ok=True)


def fetch_search(query: str):
    if not query.strip():
        return []
    import html as html_module
    headers = {
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
    }
    url = "https://lite.duckduckgo.com/lite/?q=" + urllib.parse.quote(query.strip())
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            content = resp.read().decode("utf-8", errors="replace")

        links = re.findall(r'<a[^>]+href=[\'\"](https?://[^\'\"]+)[\'\"][^>]*>(.*?)</a>', content)
        snippets = re.findall(r'<td class=[\'\"]result-snippet[\'\"]>(.*?)</td>', content, re.DOTALL)

        results = []
        clean_links = []
        for u, title_raw in links:
            if "duckduckgo.com" not in u and not u.startswith("/"):
                t = html_module.unescape(re.sub(r'<[^>]+>', '', title_raw).strip())
                if len(t) > 2:
                    clean_links.append((u, t))

        for i, (u, title) in enumerate(clean_links[:25]):
            snip = ""
            if i < len(snippets):
                snip = html_module.unescape(re.sub(r'<[^>]+>', '', snippets[i]).strip())
            results.append({
                "title": title,
                "url": u,
                "snippet": snip,
                "domain": urllib.parse.urlparse(u).netloc
            })
        return results
    except Exception as e:
        return [{"title": "Search Error", "url": "", "snippet": str(e), "domain": ""}]


def load_workbenches():
    ensure_dirs()
    benches = []
    for f in sorted(WORKBENCHES_DIR.glob("*.json")):
        try:
            d = json.loads(f.read_text(encoding="utf-8"))
            benches.append({
                "id": f.stem,
                "name": d.get("name", f.stem),
                "tabs": d.get("tabs", []),
                "updated_at": d.get("updated_at", "")
            })
        except Exception:
            continue
    return benches


def load_history():
    ensure_dirs()
    if not HISTORY_JSONL.exists():
        return []
    entries = []
    try:
        lines = HISTORY_JSONL.read_text(encoding="utf-8").splitlines()
        for line in reversed(lines):
            line = line.strip()
            if line:
                entries.append(json.loads(line))
    except Exception:
        pass
    return entries[:50]


def load_bookmarks():
    ensure_dirs()
    if not BOOKMARKS_FILE.exists():
        return []
    bms = []
    try:
        lines = BOOKMARKS_FILE.read_text(encoding="utf-8").splitlines()
        for line in reversed(lines):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = [p.strip() for p in line.split("|")]
            if len(parts) >= 2:
                bms.append({
                    "url": parts[0],
                    "title": parts[1],
                    "tag": parts[2] if len(parts) > 2 else "general"
                })
    except Exception:
        pass
    return bms


class WebflowTUI:
    def set_cursor(self, visibility: int):
        try:
            curses.curs_set(visibility)
        except curses.error:
            pass

    def __init__(self, stdscr):
        self.stdscr = stdscr
        self.set_cursor(0)
        self.has_colors = curses.has_colors()
        if self.has_colors:
            try:
                curses.start_color()
                curses.use_default_colors()
                curses.init_pair(1, curses.COLOR_CYAN, -1)     # Header/Focus
                curses.init_pair(2, curses.COLOR_GREEN, -1)    # Success/Tier1
                curses.init_pair(3, curses.COLOR_YELLOW, -1)   # Warning/Tier3
                curses.init_pair(4, curses.COLOR_MAGENTA, -1)  # Selection highlight
                curses.init_pair(5, curses.COLOR_WHITE, curses.COLOR_BLUE)     # Active row inverted
                curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_CYAN)     # Active tab
                curses.init_pair(7, curses.COLOR_WHITE, -1)    # Regular text
            except Exception:
                self.has_colors = False

        self.orig_color_pair = curses.color_pair
        curses.color_pair = lambda n: self.orig_color_pair(n) if self.has_colors else 0

        self.nav_items = [
            ("⚡ Ephemeral Search", "search"),
            ("📂 Workbenches", "workbenches"),
            ("➕ New Workbench", "new_bench"),
            ("📅 History (Chronological)", "history"),
            ("🔖 Bookmarks (Deliberate)", "bookmarks")
        ]
        self.active_pane = 0  # 0: Nav, 1: Middle List, 2: Preview
        self.nav_idx = 0
        self.list_idx = 0

        self.search_query = ""
        self.search_results = []
        self.is_searching = False
        self.status_msg = "NORMAL  |  / Search  |  w Add to Bench  |  Enter Open  |  q Quit"

        self.workbenches = load_workbenches()
        self.history = load_history()
        self.bookmarks = load_bookmarks()

    def run(self):
        self.stdscr.nodelay(False)
        self.stdscr.keypad(True)

        while True:
            self.draw()
            key = self.stdscr.getch()

            if key in [ord('q'), ord('Q')] and not self.is_searching:
                break

            self.handle_input(key)

    def safe_addstr(self, y, x, text, attr=0):
        try:
            h, w = self.stdscr.getmaxyx()
            if y < 0 or y >= h or x < 0 or x >= w:
                return
            max_len = w - x
            if y == h - 1:
                max_len = max(0, w - x - 1)
            if max_len <= 0:
                return
            trimmed = str(text)[:max_len]
            if attr:
                self.stdscr.addstr(y, x, trimmed, attr)
            else:
                self.stdscr.addstr(y, x, trimmed)
        except curses.error:
            pass

    def draw(self):
        self.stdscr.erase()
        h, w = self.stdscr.getmaxyx()
        if h < 16 or w < 70:
            self.safe_addstr(0, 0, "Terminal window too small for 3-pane layout.")
            self.stdscr.refresh()
            return

        # 1. Header Banner
        title_bar = " 🌐 Webflow 0.2 (Pre-Alpha) — Terminal-First Sovereign Web Architecture "
        self.safe_addstr(0, 0, title_bar[:w - 1].ljust(w - 1), curses.color_pair(6) | curses.A_BOLD)

        # 2. Dimensions for 3 columns: Nav (22%), Middle (43%), Preview (35%)
        nav_w = max(24, int(w * 0.22))
        mid_w = int(w * 0.45)
        prev_w = w - nav_w - mid_w - 2
        content_h = h - 3

        # Column 1: Navigation
        self.draw_box(1, 0, content_h, nav_w, " 1. Sections ", self.active_pane == 0)
        for idx, (label, tag) in enumerate(self.nav_items):
            y = 2 + idx * 2
            if y < content_h:
                if idx == self.nav_idx:
                    self.safe_addstr(y, 1, f" ❯ {label}".ljust(nav_w - 2)[:nav_w - 2], curses.color_pair(5) | curses.A_BOLD)
                else:
                    self.safe_addstr(y, 1, f"   {label}".ljust(nav_w - 2)[:nav_w - 2], curses.color_pair(7))

        # Column 2: Active Middle Pane
        current_section = self.nav_items[self.nav_idx][1]
        mid_title = f" 2. {self.nav_items[self.nav_idx][0]} "
        self.draw_box(1, nav_w, content_h, mid_w, mid_title, self.active_pane == 1)

        # Draw Middle Content based on Section
        if current_section == "search":
            self.draw_search_pane(1, nav_w, content_h, mid_w)
        elif current_section == "workbenches":
            self.draw_workbenches_pane(1, nav_w, content_h, mid_w)
        elif current_section == "new_bench":
            self.draw_new_bench_pane(1, nav_w, content_h, mid_w)
        elif current_section == "history":
            self.draw_history_pane(1, nav_w, content_h, mid_w)
        elif current_section == "bookmarks":
            self.draw_bookmarks_pane(1, nav_w, content_h, mid_w)

        # Column 3: Live Preview Panel
        self.draw_box(1, nav_w + mid_w, content_h, prev_w, " 3. Live Preview & Route ", self.active_pane == 2)
        self.draw_preview_pane(1, nav_w + mid_w, content_h, prev_w, current_section)

        # 4. Status Bar (safely leaving last column blank to prevent cursor wrap error)
        status_bar = f" {self.status_msg} "
        self.safe_addstr(h - 1, 0, status_bar[:w - 1].ljust(w - 1), curses.color_pair(6))

        self.stdscr.refresh()

    def get_visible_slice(self, items, selected_idx, max_rows):
        if not items or max_rows <= 0:
            return [], 0
        total = len(items)
        if total <= max_rows:
            return [(i, items[i]) for i in range(total)], 0
        half = max_rows // 2
        start = max(0, min(selected_idx - half, total - max_rows))
        end = start + max_rows
        return [(i, items[i]) for i in range(start, end)], start

    def draw_box(self, y, x, h, w, title="", is_active=False):
        color = curses.color_pair(1) if is_active else curses.color_pair(7)
        # Rounded horizontal borders
        self.safe_addstr(y, x, "╭" + "─" * (w - 2) + "╮", color)
        for i in range(1, h - 1):
            self.safe_addstr(y + i, x, "│", color)
            self.safe_addstr(y + i, x + w - 1, "│", color)
        self.safe_addstr(y + h - 1, x, "╰" + "─" * (w - 2) + "╯", color)

        if title:
            t = f" {title.strip()} "
            if len(t) < w - 4:
                self.safe_addstr(y, x + 2, t, color | curses.A_BOLD)

    def draw_search_pane(self, py, px, ph, pw):
        # Search Box
        box_text = f" 🔍 {self.search_query}" if self.search_query else " 🔍 Type query... (Press / to search)"
        attr = curses.color_pair(4) | curses.A_BOLD if self.is_searching else curses.color_pair(7)
        self.safe_addstr(py + 1, px + 2, box_text[:pw - 4].ljust(pw - 4), attr)
        self.safe_addstr(py + 2, px + 1, "─" * (pw - 2), curses.color_pair(7))

        max_rows = ph - 4
        if not self.search_results:
            self.safe_addstr(py + 4, px + 3, "No results. Press / to search directly.", curses.color_pair(3))
            return

        visible_items, _ = self.get_visible_slice(self.search_results, self.list_idx, max_rows)
        for row_offset, (real_idx, item) in enumerate(visible_items):
            y = py + 3 + row_offset
            is_sel = (real_idx == self.list_idx) and self.active_pane == 1
            line = f"{real_idx + 1:2d}. {item.get('title', '')}"
            if is_sel:
                self.safe_addstr(y, px + 1, line[:pw - 2].ljust(pw - 2), curses.color_pair(5) | curses.A_BOLD)
            else:
                self.safe_addstr(y, px + 2, line[:pw - 4], curses.color_pair(7))

    def draw_workbenches_pane(self, py, px, ph, pw):
        if not self.workbenches:
            self.safe_addstr(py + 3, px + 3, "No workbenches saved yet.", curses.color_pair(3))
            self.safe_addstr(py + 5, px + 3, "Navigate to ➕ New Workbench to create one.", curses.color_pair(7))
            return

        max_rows = ph - 3
        visible_items, _ = self.get_visible_slice(self.workbenches, self.list_idx, max_rows)
        for row_offset, (real_idx, b) in enumerate(visible_items):
            y = py + 2 + row_offset
            is_sel = (real_idx == self.list_idx) and self.active_pane == 1
            tab_count = len(b.get("tabs", []))
            line = f" 📂 {b.get('name')}  [{tab_count} tabs]"
            if is_sel:
                self.safe_addstr(y, px + 1, line[:pw - 2].ljust(pw - 2), curses.color_pair(5) | curses.A_BOLD)
            else:
                self.safe_addstr(y, px + 2, line[:pw - 4], curses.color_pair(7))

    def draw_new_bench_pane(self, py, px, ph, pw):
        self.safe_addstr(py + 3, px + 3, "Create Named Persistent Workbench:", curses.color_pair(1) | curses.A_BOLD)
        self.safe_addstr(py + 5, px + 3, "Press [Enter] to name and initialize a workbench.", curses.color_pair(7))
        self.safe_addstr(py + 7, px + 3, "Workbenches persist your open tabs and cookies,", curses.color_pair(3))
        self.safe_addstr(py + 8, px + 3, "unloading completely from memory when closed.", curses.color_pair(3))

    def draw_history_pane(self, py, px, ph, pw):
        if not self.history:
            self.safe_addstr(py + 3, px + 3, "History is currently empty.", curses.color_pair(3))
            return

        max_rows = ph - 3
        visible_items, _ = self.get_visible_slice(self.history, self.list_idx, max_rows)
        for row_offset, (real_idx, entry) in enumerate(visible_items):
            y = py + 2 + row_offset
            is_sel = (real_idx == self.list_idx) and self.active_pane == 1
            t_str = entry.get("time", entry.get("timestamp", ""))
            tier = entry.get("tier", "T3")
            title = entry.get("title", entry.get("url", ""))
            line = f" [{t_str}] [{tier}] {title}"
            if is_sel:
                self.safe_addstr(y, px + 1, line[:pw - 2].ljust(pw - 2), curses.color_pair(5) | curses.A_BOLD)
            else:
                self.safe_addstr(y, px + 2, line[:pw - 4], curses.color_pair(7))

    def draw_bookmarks_pane(self, py, px, ph, pw):
        if not self.bookmarks:
            self.safe_addstr(py + 3, px + 3, "No deliberate bookmarks found.", curses.color_pair(3))
            return

        max_rows = ph - 3
        visible_items, _ = self.get_visible_slice(self.bookmarks, self.list_idx, max_rows)
        for row_offset, (real_idx, bm) in enumerate(visible_items):
            y = py + 2 + row_offset
            is_sel = (real_idx == self.list_idx) and self.active_pane == 1
            tag = bm.get("tag", "general")
            title = bm.get("title", bm.get("url", ""))
            line = f" [{tag}] {title}"
            if is_sel:
                self.safe_addstr(y, px + 1, line[:pw - 2].ljust(pw - 2), curses.color_pair(5) | curses.A_BOLD)
            else:
                self.safe_addstr(y, px + 2, line[:pw - 4], curses.color_pair(7))

    def draw_preview_pane(self, py, px, ph, pw, section):
        sel_item = None
        if section == "search" and self.search_results and self.list_idx < len(self.search_results):
            sel_item = self.search_results[self.list_idx]
            title = sel_item.get("title", "")
            url = sel_item.get("url", "")
            snippet = sel_item.get("snippet", "")
            domain = sel_item.get("domain", "")

            # Predict tier
            tier = "Tier 1: Terminal Markdown" if any(k in url for k in ["wiki", "blog", "news", "text"]) else "Tier 3: WebKitGTK Canvas"

            self.safe_addstr(py + 2, px + 2, "Title:", curses.color_pair(1) | curses.A_BOLD)
            self.safe_addstr(py + 3, px + 2, title[:pw - 4], curses.color_pair(7))

            self.safe_addstr(py + 5, px + 2, "URL:", curses.color_pair(1) | curses.A_BOLD)
            self.safe_addstr(py + 6, px + 2, url[:pw - 4], curses.color_pair(2))

            self.safe_addstr(py + 8, px + 2, "Target Route:", curses.color_pair(1) | curses.A_BOLD)
            self.safe_addstr(py + 9, px + 2, tier[:pw - 4], curses.color_pair(3))

            self.safe_addstr(py + 11, px + 2, "Snippet:", curses.color_pair(1) | curses.A_BOLD)
            words = snippet.split()
            line_y = py + 12
            cur_line = []
            for w in words:
                if len(" ".join(cur_line + [w])) < pw - 4:
                    cur_line.append(w)
                else:
                    if line_y < py + ph - 4:
                        self.safe_addstr(line_y, px + 2, " ".join(cur_line), curses.color_pair(7))
                        line_y += 1
                    cur_line = [w]
            if cur_line and line_y < py + ph - 4:
                self.safe_addstr(line_y, px + 2, " ".join(cur_line), curses.color_pair(7))

        elif section == "workbenches" and self.workbenches and self.list_idx < len(self.workbenches):
            bench = self.workbenches[self.list_idx]
            self.safe_addstr(py + 2, px + 2, f"Workbench: {bench.get('name')}", curses.color_pair(1) | curses.A_BOLD)
            self.safe_addstr(py + 4, px + 2, f"Updated: {bench.get('updated_at')}", curses.color_pair(7))
            self.safe_addstr(py + 6, px + 2, "Persisted Tabs:", curses.color_pair(2) | curses.A_BOLD)

            tabs = bench.get("tabs", [])
            for ti, tab in enumerate(tabs[:ph - 10]):
                u = tab.get("url", "")
                t = tab.get("title", u)
                self.safe_addstr(py + 8 + ti, px + 2, f"[{ti+1}] {t[:pw-8]}", curses.color_pair(7))

        elif section == "history" and self.history and self.list_idx < len(self.history):
            h_entry = self.history[self.list_idx]
            self.safe_addstr(py + 2, px + 2, "History Entry:", curses.color_pair(1) | curses.A_BOLD)
            self.safe_addstr(py + 4, px + 2, f"Title: {h_entry.get('title', '')[:pw-4]}", curses.color_pair(7))
            self.safe_addstr(py + 6, px + 2, f"URL: {h_entry.get('url', '')[:pw-4]}", curses.color_pair(2))
            self.safe_addstr(py + 8, px + 2, f"Time: {h_entry.get('timestamp', '')}", curses.color_pair(7))
            self.safe_addstr(py + 10, px + 2, f"Tier: {h_entry.get('tier', '')}", curses.color_pair(3))

        else:
            self.safe_addstr(py + 3, px + 3, "No item selected for preview.", curses.color_pair(7))

        # Bottom Action Hints in Preview Box
        self.safe_addstr(py + ph - 3, px + 2, "─" * (pw - 4), curses.color_pair(7))
        self.safe_addstr(py + ph - 2, px + 2, "[Enter] Open | [w] Add to Bench | [b] Mark", curses.color_pair(1))

    def handle_input(self, key):
        # Searching text input
        if self.is_searching:
            if key in [10, 13]:  # Enter: execute search
                self.is_searching = False
                self.set_cursor(0)
                if self.search_query.strip():
                    self.status_msg = f"Searching for '{self.search_query}'..."
                    self.draw()
                    self.search_results = fetch_search(self.search_query)
                    self.list_idx = 0
                    self.active_pane = 1
                    self.status_msg = f"Found {len(self.search_results)} results for '{self.search_query}'."
            elif key in [27]:  # Escape: cancel search
                self.is_searching = False
                self.set_cursor(0)
            elif key in [curses.KEY_BACKSPACE, 127, 8]:
                self.search_query = self.search_query[:-1]
            elif 32 <= key <= 126:
                self.search_query += chr(key)
            return

        # Trigger search bar
        if key == ord('/'):
            self.nav_idx = 0  # switch to search section
            self.is_searching = True
            self.set_cursor(1)
            self.status_msg = "Enter search query and press [Enter]..."
            return

        # Pane switching
        if key in [ord('l'), ord('\t'), curses.KEY_RIGHT]:
            self.active_pane = min(2, self.active_pane + 1)
        elif key in [ord('h'), curses.KEY_LEFT, curses.KEY_BTAB]:
            self.active_pane = max(0, self.active_pane - 1)

        # Vertical Navigation
        elif key in [ord('j'), curses.KEY_DOWN]:
            if self.active_pane == 0:
                self.nav_idx = (self.nav_idx + 1) % len(self.nav_items)
                self.list_idx = 0
            elif self.active_pane == 1:
                cur_len = self.get_current_list_len()
                if cur_len > 0:
                    self.list_idx = (self.list_idx + 1) % cur_len
        elif key in [ord('k'), curses.KEY_UP]:
            if self.active_pane == 0:
                self.nav_idx = (self.nav_idx - 1) % len(self.nav_items)
                self.list_idx = 0
            elif self.active_pane == 1:
                cur_len = self.get_current_list_len()
                if cur_len > 0:
                    self.list_idx = (self.list_idx - 1) % cur_len

        # Open selection (Enter)
        elif key in [10, 13]:
            self.execute_selection()

        # Add to workbench (w)
        elif key in [ord('w'), ord('W')]:
            self.prompt_add_to_workbench()

        # Add bookmark (b)
        elif key in [ord('b'), ord('B')]:
            self.prompt_add_bookmark()

    def get_current_list_len(self):
        sec = self.nav_items[self.nav_idx][1]
        if sec == "search":
            return len(self.search_results)
        elif sec == "workbenches":
            return len(self.workbenches)
        elif sec == "history":
            return len(self.history)
        elif sec == "bookmarks":
            return len(self.bookmarks)
        return 0

    def execute_selection(self):
        sec = self.nav_items[self.nav_idx][1]
        wf_open = BIN_DIR / "wf-open"

        if sec == "search" and self.search_results and self.list_idx < len(self.search_results):
            url = self.search_results[self.list_idx].get("url")
            if url:
                curses.endwin()
                subprocess.run([str(wf_open), url])
                self.stdscr.refresh()

        elif sec == "workbenches" and self.workbenches and self.list_idx < len(self.workbenches):
            bench_name = self.workbenches[self.list_idx].get("name")
            wf_bench = BIN_DIR / "wf-workbench"
            curses.endwin()
            subprocess.run([str(wf_bench), "open", bench_name])
            self.stdscr.refresh()

        elif sec == "new_bench":
            self.prompt_create_workbench()

        elif sec == "history" and self.history and self.list_idx < len(self.history):
            url = self.history[self.list_idx].get("url")
            if url:
                curses.endwin()
                subprocess.run([str(wf_open), url])
                self.stdscr.refresh()

        elif sec == "bookmarks" and self.bookmarks and self.list_idx < len(self.bookmarks):
            url = self.bookmarks[self.list_idx].get("url")
            if url:
                curses.endwin()
                subprocess.run([str(wf_open), url])
                self.stdscr.refresh()

    def prompt_create_workbench(self):
        curses.echo()
        self.set_cursor(1)
        h, w = self.stdscr.getmaxyx()
        self.safe_addstr(h - 2, 2, "Enter New Workbench Name: ", curses.color_pair(1) | curses.A_BOLD)
        name_bytes = self.stdscr.getstr(h - 2, 30, 40)
        curses.noecho()
        self.set_cursor(0)
        name = name_bytes.decode("utf-8").strip()
        if name:
            wf_bench = BIN_DIR / "wf-workbench"
            subprocess.run([str(wf_bench), "create", name])
            self.workbenches = load_workbenches()
            self.nav_idx = 1
            self.active_pane = 1
            self.status_msg = f"[✔] Workbench '{name}' initialized."

    def prompt_add_to_workbench(self):
        target_url = self.get_selected_url()
        if not target_url:
            self.status_msg = "[-] No valid URL selected to add."
            return

        curses.echo()
        self.set_cursor(1)
        h, w = self.stdscr.getmaxyx()
        self.safe_addstr(h - 2, 2, "Add to Workbench Name: ", curses.color_pair(1) | curses.A_BOLD)
        name_bytes = self.stdscr.getstr(h - 2, 26, 40)
        curses.noecho()
        self.set_cursor(0)
        bench_name = name_bytes.decode("utf-8").strip()
        if bench_name:
            wf_bench = BIN_DIR / "wf-workbench"
            subprocess.run([str(wf_bench), "add", bench_name, target_url])
            self.workbenches = load_workbenches()
            self.status_msg = f"[✔] Added URL to workbench '{bench_name}'."

    def prompt_add_bookmark(self):
        target_url = self.get_selected_url()
        if not target_url:
            self.status_msg = "[-] No valid URL selected to bookmark."
            return

        curses.echo()
        self.set_cursor(1)
        h, w = self.stdscr.getmaxyx()
        self.safe_addstr(h - 2, 2, "Deliberate Folder/Tag: ", curses.color_pair(1) | curses.A_BOLD)
        tag_bytes = self.stdscr.getstr(h - 2, 26, 30)
        tag = tag_bytes.decode("utf-8").strip() or "general"

        self.safe_addstr(h - 2, 2, " " * (w - 4))
        self.safe_addstr(h - 2, 2, "Custom Note / Title: ", curses.color_pair(1) | curses.A_BOLD)
        title_bytes = self.stdscr.getstr(h - 2, 24, 50)
        title = title_bytes.decode("utf-8").strip() or target_url

        curses.noecho()
        self.set_cursor(0)

        with open(BOOKMARKS_FILE, "a", encoding="utf-8") as f:
            f.write(f"{target_url} | {title} | {tag}\n")
        self.bookmarks = load_bookmarks()
        self.status_msg = f"[✔] Bookmarked in [{tag}]: {title}"

    def get_selected_url(self):
        sec = self.nav_items[self.nav_idx][1]
        if sec == "search" and self.search_results and self.list_idx < len(self.search_results):
            return self.search_results[self.list_idx].get("url")
        elif sec == "history" and self.history and self.list_idx < len(self.history):
            return self.history[self.list_idx].get("url")
        elif sec == "bookmarks" and self.bookmarks and self.list_idx < len(self.bookmarks):
            return self.bookmarks[self.list_idx].get("url")
        return None


def main():
    try:
        curses.wrapper(lambda stdscr: WebflowTUI(stdscr).run())
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
