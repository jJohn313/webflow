#!/usr/bin/env python3
"""
wf-view - Tier 3: In-House Modal WebKitGTK Browser for Webflow
High-performance, chromeless, single-process Wayland client with Vim modal navigation.
"""
import os
import sys
import json
import time
import argparse
import urllib.parse
import subprocess
from pathlib import Path

os.environ.setdefault("GDK_BACKEND", "wayland,x11")

import gi
try:
    gi.require_version("WebKit2", "4.1")
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib, WebKit2 as WebKit
except ValueError as e:
    sys.stderr.write(f"Error loading WebKit2GTK 4.1 / GTK 3.0: {e}\n")
    sys.stderr.write("Ensure 'webkit2gtk-4.1' and 'python-gobject' are installed.\n")
    sys.exit(1)


def extract_root_domain(url: str) -> str:
    parsed = urllib.parse.urlparse(url)
    netloc = parsed.netloc.split(":")[0].lower()
    if not netloc:
        return "local"
    parts = netloc.split(".")
    if len(parts) >= 2:
        # Handle two-part TLDs like co.uk, org.uk, com.au
        if len(parts) >= 3 and len(parts[-2]) <= 3 and len(parts[-1]) == 2:
            return ".".join(parts[-3:])
        return ".".join(parts[-2:])
    return netloc


class WebflowViewer(Gtk.Window):
    def __init__(self, initial_url: str, workbench: str = None):
        super().__init__()
        self.initial_url = initial_url if "://" in initial_url else f"https://{initial_url}"
        self.root_domain = extract_root_domain(self.initial_url)
        self.workbench = workbench
        self.mode = "NORMAL"  # NORMAL | INSERT | HINTS | SEARCH
        self.pending_g = False
        self.search_text = ""

        # Paths
        self.base_share = Path.home() / ".local" / "share" / "webflow"
        if self.workbench:
            safe_wb = "".join(c if c.isalnum() or c in "-_" else "_" for c in self.workbench.strip())
            self.session_dir = self.base_share / "sessions" / "workbenches" / safe_wb
            self.wb_manifest = self.base_share / "workbenches" / f"{safe_wb}.json"
        else:
            self.session_dir = self.base_share / "sessions" / self.root_domain
            self.wb_manifest = None

        self.session_dir.mkdir(parents=True, exist_ok=True)
        self.bookmarks_file = self.base_share / "bookmarks.txt"
        self.hints_script_path = Path(__file__).resolve().parent.parent / "assets" / "hints.js"

        self.setup_window()
        self.setup_engine()
        self.setup_keybindings()
        self.load_url(self.initial_url)

    def setup_window(self):
        self.set_wmclass("wf-view", "wf-view")
        self.set_default_size(1280, 800)
        self.set_decorated(False)
        self.connect("destroy", self.on_quit)

    def setup_engine(self):
        data_manager = WebKit.WebsiteDataManager(
            base_data_directory=str(self.session_dir),
            base_cache_directory=str(self.session_dir / "cache"),
            local_storage_directory=str(self.session_dir / "localstorage"),
            disk_cache_directory=str(self.session_dir / "diskcache")
        )
        cookie_manager = data_manager.get_cookie_manager()
        cookie_manager.set_persistent_storage(
            str(self.session_dir / "cookies.sqlite"),
            WebKit.CookiePersistentStorage.SQLITE
        )
        cookie_manager.set_accept_policy(WebKit.CookieAcceptPolicy.NO_THIRD_PARTY)

        web_context = WebKit.WebContext.new_with_website_data_manager(data_manager)

        self.ucm = WebKit.UserContentManager()
        self.ucm.register_script_message_handler("webflow")
        self.ucm.connect("script-message-received::webflow", self.on_js_message)

        focus_observer_js = """
        (function() {
            function isEditable(el) {
                if (!el) return false;
                var tag = (el.tagName || '').toLowerCase();
                return el.isContentEditable || tag === 'textarea' ||
                    (tag === 'input' && !['checkbox','radio','button','submit','reset','hidden'].includes(el.type));
            }
            window.addEventListener('focusin', function(e) {
                if (isEditable(e.target) && window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.webflow) {
                    window.webkit.messageHandlers.webflow.postMessage(JSON.stringify({action: 'set_mode', mode: 'INSERT'}));
                }
            }, true);
            window.addEventListener('focusout', function(e) {
                if (isEditable(e.target) && window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.webflow) {
                    window.webkit.messageHandlers.webflow.postMessage(JSON.stringify({action: 'set_mode', mode: 'NORMAL'}));
                }
            }, true);
        })();
        """
        user_script = WebKit.UserScript(
            source=focus_observer_js,
            injected_frames=WebKit.UserContentInjectedFrames.ALL_FRAMES,
            injection_time=WebKit.UserScriptInjectionTime.END,
            whitelist=[],
            blacklist=[]
        )
        self.ucm.add_script(user_script)

        self.web_view = WebKit.WebView.new_with_context(web_context)
        if hasattr(self.web_view, "set_user_content_manager"):
            self.web_view.set_user_content_manager(self.ucm)

        settings = self.web_view.get_settings()
        settings.set_enable_developer_extras(False)
        settings.set_enable_smooth_scrolling(True)
        settings.set_javascript_can_open_windows_automatically(False)
        settings.set_enable_back_forward_navigation_gestures(True)

        self.find_controller = self.web_view.get_find_controller()

        self.web_view.connect("notify::title", self.on_title_changed)
        self.web_view.connect("notify::uri", self.on_uri_changed)
        self.web_view.connect("decide-policy", self.on_decide_policy)
        self.web_view.connect("create", self.on_create_web_view)

        self.add(self.web_view)
        self.show_all()
        self.update_title()

    def on_create_web_view(self, web_view, navigation_action):
        # Redirect popups / target="_blank" into current view
        req = navigation_action.get_request()
        if req and req.get_uri():
            self.web_view.load_uri(req.get_uri())
        return None

    def on_decide_policy(self, web_view, decision, decision_type):
        if decision_type == WebKit.PolicyDecisionType.NEW_WINDOW_ACTION:
            nav_action = decision.get_navigation_action()
            req = nav_action.get_request()
            if req and req.get_uri():
                self.web_view.load_uri(req.get_uri())
            decision.ignore()
            return True
        return False

    def eval_js(self, script: str):
        if hasattr(self.web_view, "evaluate_javascript"):
            self.web_view.evaluate_javascript(script, -1, None, None, None, None, None)
        else:
            self.web_view.run_javascript(script, None, None, None)

    def load_url(self, url: str):
        self.web_view.load_uri(url)

    def update_title(self):
        # Always include (@domain) in title so wf-pass can reliably extract it via hyprctl
        page_title = self.web_view.get_title() or self.root_domain
        wb_tag = f" [WB:{self.workbench}]" if self.workbench else ""
        search_tag = f" [/{self.search_text}]" if self.mode == "SEARCH" else ""
        self.set_title(f"wf-view [{self.mode}]{wb_tag}{search_tag} (@{self.root_domain}) - {page_title}")

    def on_title_changed(self, view, param):
        self.update_title()

    def on_uri_changed(self, view, param):
        uri = self.web_view.get_uri() or ""
        new_domain = extract_root_domain(uri)
        if new_domain != self.root_domain:
            self.root_domain = new_domain
        self.update_title()

    def on_js_message(self, manager, js_result):
        try:
            val = js_result.get_value().to_string()
            data = json.loads(val) if val.startswith("{") else {"action": "set_mode", "mode": val}
            action = data.get("action")
            if action == "set_mode":
                self.mode = data.get("mode", "NORMAL")
                self.update_title()
            elif action == "hints_dismissed":
                if self.mode == "HINTS":
                    self.mode = "NORMAL"
                    self.update_title()
        except Exception:
            pass

    def setup_keybindings(self):
        self.connect("key-press-event", self.on_key_press)

    def on_key_press(self, widget, event):
        keyname = Gdk.keyval_name(event.keyval)
        if not keyname:
            return False

        # Global Escape: always drop to NORMAL mode, clear search/hints, blur inputs
        if keyname == "Escape":
            self.mode = "NORMAL"
            self.pending_g = False
            self.find_controller.search_finish()
            self.eval_js(
                "if (document.activeElement) document.activeElement.blur(); "
                "if (window.__wf_cleanup_hints) window.__wf_cleanup_hints();"
            )
            self.update_title()
            return True

        if self.mode == "SEARCH":
            if keyname in ("Return", "KP_Enter"):
                self.mode = "NORMAL"
                if self.search_text:
                    self.find_controller.search(
                        self.search_text,
                        WebKit.FindOptions.CASE_INSENSITIVE | WebKit.FindOptions.WRAP_AROUND,
                        1000
                    )
                self.update_title()
            elif keyname == "BackSpace":
                self.search_text = self.search_text[:-1]
                self.update_title()
            elif len(keyname) == 1 and 32 <= event.keyval <= 126:
                self.search_text += chr(event.keyval)
                self.update_title()
            elif keyname == "space":
                self.search_text += " "
                self.update_title()
            return True

        if self.mode in ("INSERT", "HINTS"):
            return False

        # NORMAL MODE KEYBINDINGS
        if keyname == "j":
            self.eval_js("window.scrollBy({top: 120, behavior: 'smooth'});")
            return True
        elif keyname == "k":
            self.eval_js("window.scrollBy({top: -120, behavior: 'smooth'});")
            return True
        elif keyname == "d":
            self.eval_js("window.scrollBy({top: window.innerHeight * 0.5, behavior: 'smooth'});")
            return True
        elif keyname == "u":
            self.eval_js("window.scrollBy({top: -window.innerHeight * 0.5, behavior: 'smooth'});")
            return True
        elif keyname == "g":
            if self.pending_g:
                self.eval_js("window.scrollTo({top: 0, behavior: 'smooth'});")
                self.pending_g = False
            else:
                self.pending_g = True
            return True
        elif keyname == "G":
            self.eval_js("window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'});")
            return True
        elif keyname == "H":
            if self.web_view.can_go_back():
                self.web_view.go_back()
            return True
        elif keyname == "L":
            if self.web_view.can_go_forward():
                self.web_view.go_forward()
            return True
        elif keyname == "r":
            self.web_view.reload()
            return True
        elif keyname == "R":
            self.web_view.reload_bypass_cache()
            return True
        elif keyname == "slash":
            self.mode = "SEARCH"
            self.search_text = ""
            self.update_title()
            return True
        elif keyname == "n":
            if self.search_text:
                self.find_controller.search_next()
            return True
        elif keyname == "N":
            if self.search_text:
                self.find_controller.search_previous()
            return True
        elif keyname in ("plus", "equal"):
            self.web_view.set_zoom_level(self.web_view.get_zoom_level() + 0.1)
            return True
        elif keyname == "minus":
            self.web_view.set_zoom_level(max(0.3, self.web_view.get_zoom_level() - 0.1))
            return True
        elif keyname == "0":
            self.web_view.set_zoom_level(1.0)
            return True
        elif keyname == "E":
            # Demote current page to wf-reader inside a new terminal or stdout
            uri = self.web_view.get_uri() or self.initial_url
            wf_reader = Path(__file__).resolve().parent / "wf-reader"
            subprocess.Popen(["kitty", "-e", str(wf_reader), uri])
            self.on_quit()
            return True
        elif keyname == "b":
            self.bookmark_current()
            return True
        elif keyname == "y":
            self.copy_url_to_clipboard()
            return True
        elif keyname == "q":
            self.on_quit()
            return True
        elif keyname == "i":
            self.mode = "INSERT"
            self.update_title()
            return True
        elif keyname == "f":
            self.trigger_hints()
            return True

        self.pending_g = False
        return False

    def trigger_hints(self):
        if not self.hints_script_path.exists():
            return
        try:
            hints_js = self.hints_script_path.read_text(encoding="utf-8")
            self.mode = "HINTS"
            self.update_title()
            self.eval_js(hints_js)
        except Exception as e:
            sys.stderr.write(f"Failed to inject hints: {e}\n")

    def bookmark_current(self):
        uri = self.web_view.get_uri() or self.initial_url
        title = self.web_view.get_title() or self.root_domain
        self.bookmarks_file.parent.mkdir(parents=True, exist_ok=True)
        with open(self.bookmarks_file, "a", encoding="utf-8") as f:
            f.write(f"{uri} | {title} | general\n")
        print(f"[wf-view] Bookmarked: {uri}")

    def copy_url_to_clipboard(self):
        uri = self.web_view.get_uri() or self.initial_url
        try:
            proc = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE)
            proc.communicate(input=uri.encode("utf-8"))
        except FileNotFoundError:
            clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            clipboard.set_text(uri, -1)

    def sync_workbench_on_exit(self):
        if not self.wb_manifest or not self.wb_manifest.exists():
            return
        try:
            uri = self.web_view.get_uri() or self.initial_url
            title = self.web_view.get_title() or uri
            data = json.loads(self.wb_manifest.read_text(encoding="utf-8"))
            tabs = data.get("tabs", [])
            now = time.strftime("%Y-%m-%d %H:%M:%S")
            updated = False
            for t in tabs:
                if t.get("url") == self.initial_url or t.get("url") == uri:
                    t["url"] = uri
                    t["title"] = title
                    t["updated_at"] = now
                    updated = True
                    break
            if not updated:
                tabs.append({"url": uri, "title": title, "added_at": now})
            data["tabs"] = tabs
            data["updated_at"] = now
            self.wb_manifest.write_text(json.dumps(data, indent=2), encoding="utf-8")
        except Exception:
            pass

    def on_quit(self, *args):
        self.sync_workbench_on_exit()
        Gtk.main_quit()
        sys.exit(0)


def main():
    parser = argparse.ArgumentParser(description="Webflow Tier 3 WebKitGTK Viewer")
    parser.add_argument("url", help="Target URL")
    parser.add_argument("--workbench", "-w", default=None, help="Bind to named workbench session")
    args = parser.parse_args()

    app = WebflowViewer(args.url.strip(), workbench=args.workbench)
    Gtk.main()


if __name__ == "__main__":
    main()
