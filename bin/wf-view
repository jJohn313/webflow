#!/usr/bin/env python3
"""
wf-view - Tier 3: In-House Modal WebKitGTK Browser for Webflow
High-performance, chromeless, single-process Wayland client with Vim modal navigation,
multi-tab container (Gtk.Notebook), and built-in Omnibar.
"""
import os
import sys
import json
import time
import traceback
import argparse
import urllib.parse
import subprocess
import base64
import threading
from pathlib import Path

# Fix WebKitGTK DMA-BUF / EGL crash on Wayland (Hyprland + Nvidia/Mesa)
os.environ.setdefault("WEBKIT_DISABLE_DMABUF_RENDERER", "1")
os.environ.setdefault("WEBKIT_DISABLE_COMPOSITING_MODE", "0")
os.environ.setdefault("GDK_BACKEND", "wayland,x11")

LOG_FILE = Path.home() / ".local" / "share" / "webflow" / "wf-view-error.log"

def log_error(msg: str):
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}\n")
    except Exception:
        pass
    sys.stderr.write(msg + "\n")

import gi
try:
    gi.require_version("WebKit2", "4.1")
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib, Pango, WebKit2 as WebKit
except Exception:
    try:
        gi.require_version("WebKit2", "4.0")
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk, Gdk, GLib, Pango, WebKit2 as WebKit
    except Exception as e:
        log_error(f"Error loading WebKit2GTK / GTK 3.0: {e}\nEnsure 'webkit2gtk-4.1' and 'python-gobject' are installed.")
        sys.exit(1)

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))
from lib.vault import WebflowVault
from lib.shield import apply_shield_and_ram_diet
from lib.cache_manager import enforce_lru_cache_quota


def extract_root_domain(url: str) -> str:
    parsed = urllib.parse.urlparse(url)
    netloc = parsed.netloc.split(":")[0].lower()
    if not netloc:
        return "local"
    parts = netloc.split(".")
    if len(parts) >= 2:
        if len(parts) >= 3 and len(parts[-2]) <= 3 and len(parts[-1]) == 2:
            return ".".join(parts[-3:])
        return ".".join(parts[-2:])
    return netloc


FOCUS_OBSERVER_JS = """
(function() {
    function isEditable(el) {
        if (!el) return false;
        var tag = (el.tagName || '').toLowerCase();
        return el.isContentEditable || tag === 'textarea' ||
            (tag === 'input' && !['checkbox','radio','button','submit','reset','hidden'].includes(el.type));
    }
    window.addEventListener('focusin', function(e) {
        if (isEditable(e.target) && window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.webflow) {
            window.webkit.messageHandlers.webflow.postMessage(JSON.stringify({action: 'set_mode', mode: 'INSERT'}));
        }
    }, true);
    window.addEventListener('focusout', function(e) {
        if (isEditable(e.target) && window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.webflow) {
            window.webkit.messageHandlers.webflow.postMessage(JSON.stringify({action: 'set_mode', mode: 'NORMAL'}));
        }
    }, true);
})();
"""


class WebflowViewer(Gtk.Window):
    def __init__(self, urls: list, workbench: str = None, from_reader: bool = False):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        if isinstance(urls, str):
            urls = [urls]
        self.initial_urls = [u if "://" in u else f"https://{u}" for u in urls] if urls else ["https://duckduckgo.com"]
        self.workbench = workbench
        self.from_reader = from_reader
        self.mode = "NORMAL"  # NORMAL | INSERT | HINTS | SEARCH
        self.pending_g = False
        self.pending_number = None
        self.search_text = ""
        self.status_notification = ""
        self.omnibar_new_tab = False

        # Credential Vault & Autofill
        self.vault = WebflowVault()
        self.autofill_script_path = REPO_ROOT / "assets" / "autofill.js"
        self.pending_credentials = None

        self.base_share = Path.home() / ".local" / "share" / "webflow"
        # Common storage path for engine cache/data/cookies
        self.storage_dir = self.base_share / "storage"
        self.storage_dir.mkdir(parents=True, exist_ok=True)
        if self.workbench:
            safe_wb = "".join(c if c.isalnum() or c in "-_" else "_" for c in self.workbench.strip())
            self.wb_manifest = self.base_share / "workbenches" / f"{safe_wb}.json"
            self.cache_dir = self.storage_dir / "cache" / "workbenches" / safe_wb
            self.cache_quota_mb = 200
        else:
            self.wb_manifest = None
            self.cache_dir = self.storage_dir / "cache" / "ephemeral"
            self.cache_quota_mb = 150
        self.cache_dir.mkdir(parents=True, exist_ok=True)

        self.bookmarks_file = self.base_share / "bookmarks.txt"
        self.hints_script_path = REPO_ROOT / "assets" / "hints.js"

        self.setup_css()
        self.setup_window()
        self.setup_engine()
        self.setup_keybindings()

        # Open initial URLs in tabs
        for idx, u in enumerate(self.initial_urls):
            self.create_tab(u, switch_to=(idx == 0))

    @property
    def current_web_view(self) -> WebKit.WebView:
        page_num = self.notebook.get_current_page()
        if page_num >= 0:
            return self.notebook.get_nth_page(page_num)
        return None

    @property
    def root_domain(self) -> str:
        view = self.current_web_view
        if view:
            uri = view.get_uri() or ""
            if uri:
                return extract_root_domain(uri)
        return "webflow"

    @property
    def find_controller(self):
        view = self.current_web_view
        return view.get_find_controller() if view else None

    def setup_css(self):
        css = b"""
        window {
            background-color: #1a1b26;
        }
        notebook header {
            background-color: #16161e;
            border: none;
            padding: 3px 6px 0px 6px;
        }
        notebook tab {
            background-color: #1f2335;
            color: #7aa2f7;
            border: 1px solid #292e42;
            padding: 4px 10px;
            margin-right: 3px;
            border-radius: 4px 4px 0 0;
            font-size: 12px;
        }
        notebook tab:checked {
            background-color: #24283b;
            color: #ebd5b3;
            border-bottom: 2px solid #ebd5b3;
            font-weight: bold;
        }
        notebook tab button {
            padding: 0 3px;
            min-height: 14px;
            min-width: 14px;
            color: #565f89;
            background: transparent;
            border: none;
        }
        notebook tab button:hover {
            color: #f7768e;
        }
        #wf-omnibar {
            background-color: #1a1b26;
            padding: 6px 12px;
            border-bottom: 2px solid #ebd5b3;
        }
        #wf-omnibar entry {
            background-color: #24283b;
            color: #c0caf5;
            border: 1px solid #414868;
            border-radius: 4px;
            padding: 4px 10px;
            font-size: 13px;
            font-family: monospace;
        }
        #wf-omnibar entry:focus {
            border-color: #ebd5b3;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def setup_window(self):
        try:
            Gdk.set_program_class("wf-view")
        except Exception:
            pass
        self.set_default_size(1280, 800)
        self.set_decorated(False)
        self.connect("destroy", self.on_quit)

        self.main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(self.main_box)

        # InfoBar for sovereign password save prompts
        self.infobar = Gtk.InfoBar()
        self.infobar.set_no_show_all(True)
        self.infobar.set_message_type(Gtk.MessageType.QUESTION)
        self.infobar_label = Gtk.Label()
        self.infobar.get_content_area().add(self.infobar_label)
        self.infobar.add_button("Save (y)", Gtk.ResponseType.ACCEPT)
        self.infobar.add_button("Never (n)", Gtk.ResponseType.REJECT)
        self.infobar.add_button("Dismiss (Esc)", Gtk.ResponseType.CLOSE)
        self.infobar.connect("response", self.on_infobar_response)
        self.main_box.pack_start(self.infobar, False, False, 0)

        # Omnibar overlay
        self.omnibar_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.omnibar_box.set_name("wf-omnibar")
        self.omnibar_box.set_no_show_all(True)
        self.omnibar_prompt = Gtk.Label(label=" ➜ Open: ")
        self.omnibar_entry = Gtk.Entry()
        self.omnibar_entry.set_hexpand(True)
        self.omnibar_entry.connect("activate", self.on_omnibar_activate)
        self.omnibar_entry.connect("key-press-event", self.on_omnibar_key_press)
        self.omnibar_box.pack_start(self.omnibar_prompt, False, False, 4)
        self.omnibar_box.pack_start(self.omnibar_entry, True, True, 4)
        self.main_box.pack_start(self.omnibar_box, False, False, 0)

        # Notebook for multi-tab container
        self.notebook = Gtk.Notebook()
        self.notebook.set_scrollable(True)
        self.notebook.set_show_tabs(True)
        self.notebook.set_show_border(False)
        self.notebook.connect("switch-page", self.on_notebook_switch_page)
        self.main_box.pack_start(self.notebook, True, True, 0)

        self.show_all()

    def setup_engine(self):
        try:
            self.data_manager = WebKit.WebsiteDataManager(
                base_data_directory=str(self.storage_dir / "data"),
                base_cache_directory=str(self.cache_dir)
            )
            self.web_context = WebKit.WebContext.new_with_website_data_manager(self.data_manager)
            cookie_manager = self.data_manager.get_cookie_manager()
        except Exception:
            self.web_context = WebKit.WebContext.get_default()
            self.data_manager = self.web_context.get_website_data_manager()
            cookie_manager = self.web_context.get_cookie_manager()

        cookie_manager.set_persistent_storage(
            str(self.storage_dir / "cookies.sqlite"),
            WebKit.CookiePersistentStorage.SQLITE
        )
        cookie_manager.set_accept_policy(WebKit.CookieAcceptPolicy.ALWAYS)

        # Enforce LRU cache quota in background thread
        threading.Thread(
            target=enforce_lru_cache_quota,
            args=(self.cache_dir, self.cache_quota_mb),
            daemon=True
        ).start()

    def create_tab(self, url: str = None, switch_to: bool = True) -> WebKit.WebView:
        ucm = WebKit.UserContentManager()
        ucm.register_script_message_handler("webflow")
        ucm.connect("script-message-received::webflow", self.on_js_message)

        user_script = WebKit.UserScript.new(
            FOCUS_OBSERVER_JS,
            WebKit.UserContentInjectedFrames.ALL_FRAMES,
            WebKit.UserScriptInjectionTime.END,
            None,
            None
        )
        ucm.add_script(user_script)

        if self.autofill_script_path.exists():
            autofill_js = self.autofill_script_path.read_text(encoding="utf-8")
            user_script_autofill = WebKit.UserScript.new(
                autofill_js,
                WebKit.UserContentInjectedFrames.ALL_FRAMES,
                WebKit.UserScriptInjectionTime.END,
                None,
                None
            )
            ucm.add_script(user_script_autofill)

        web_view = GObject_new_webview(self.web_context, ucm)
        settings = web_view.get_settings()
        settings.set_enable_developer_extras(False)
        settings.set_enable_smooth_scrolling(True)
        settings.set_javascript_can_open_windows_automatically(False)

        apply_shield_and_ram_diet(self.web_context, self.data_manager, ucm, settings, self.base_share)

        web_view.connect("notify::title", self.on_title_changed)
        web_view.connect("notify::uri", self.on_uri_changed)
        web_view.connect("load-changed", self.on_load_changed)
        web_view.connect("decide-policy", self.on_decide_policy)
        web_view.connect("create", self.on_create_web_view)
        web_view.connect("run-file-chooser", self.on_run_file_chooser)

        # Tab Header Box
        tab_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        tab_label = Gtk.Label(label="New Tab")
        tab_label.set_ellipsize(Pango.EllipsizeMode.END)
        tab_label.set_max_width_chars(25)

        close_btn = Gtk.Button()
        close_btn.set_relief(Gtk.ReliefStyle.NONE)
        close_btn.set_focus_on_click(False)
        close_icon = Gtk.Label(label="×")
        close_btn.add(close_icon)
        close_btn.connect("clicked", lambda b: self.close_tab_for_view(web_view))

        tab_box.pack_start(tab_label, True, True, 0)
        tab_box.pack_start(close_btn, False, False, 0)
        tab_box.show_all()

        web_view._tab_label = tab_label
        web_view._tab_box = tab_box

        page_num = self.notebook.append_page(web_view, tab_box)
        self.notebook.set_tab_reorderable(web_view, True)
        web_view.show()

        if url:
            target = url if "://" in url else f"https://{url}"
            web_view.load_uri(target)

        if switch_to:
            self.notebook.set_current_page(page_num)
            web_view.grab_focus()

        self.update_title()
        return web_view

    def on_notebook_switch_page(self, notebook, page, page_num):
        for i in range(notebook.get_n_pages()):
            p = notebook.get_nth_page(i)
            if hasattr(p, "set_is_muted"):
                p.set_is_muted(i != page_num)
        GLib.idle_add(self._after_tab_switch, page)

    def _after_tab_switch(self, page):
        if page:
            page.grab_focus()
        self.update_title()
        self.try_autofill()
        return False

    def close_tab_for_view(self, view: WebKit.WebView):
        idx = self.notebook.page_num(view)
        if idx >= 0:
            self.close_tab(idx)

    def close_current_tab(self):
        cur = self.notebook.get_current_page()
        if cur >= 0:
            self.close_tab(cur)

    def close_tab(self, page_num: int):
        view = self.notebook.get_nth_page(page_num)
        if view:
            view.stop_loading()
        self.notebook.remove_page(page_num)
        if self.notebook.get_n_pages() == 0:
            self.on_quit()
        else:
            self.update_title()
            cur = self.current_web_view
            if cur:
                cur.grab_focus()

    def open_omnibar(self, new_tab: bool = False):
        self.omnibar_new_tab = new_tab
        prompt = " ➜ New Tab: " if new_tab else " ➜ Open: "
        self.omnibar_prompt.set_text(prompt)
        view = self.current_web_view
        cur_url = view.get_uri() if (view and not new_tab) else ""
        self.omnibar_entry.set_text(cur_url or "")
        self.omnibar_entry.select_region(0, -1)
        self.omnibar_box.show_all()
        self.omnibar_entry.grab_focus()
        self.mode = "INSERT"
        self.update_title()

    def close_omnibar(self):
        self.omnibar_box.hide()
        self.mode = "NORMAL"
        view = self.current_web_view
        if view:
            view.grab_focus()
        self.update_title()

    def on_omnibar_key_press(self, widget, event):
        keyname = Gdk.keyval_name(event.keyval)
        if keyname == "Escape":
            self.close_omnibar()
            return True
        return False

    def on_omnibar_activate(self, entry):
        text = entry.get_text().strip()
        if text:
            if "://" in text:
                url = text
            elif "." in text and " " not in text:
                url = f"https://{text}"
            else:
                url = f"https://duckduckgo.com/lite/?q={urllib.parse.quote_plus(text)}"

            if getattr(self, "omnibar_new_tab", False):
                self.create_tab(url, switch_to=True)
            else:
                view = self.current_web_view
                if view:
                    view.load_uri(url)
        self.close_omnibar()

    def on_load_changed(self, view, load_event):
        if load_event == WebKit.LoadEvent.FINISHED:
            self.try_autofill()

    def on_create_web_view(self, web_view, navigation_action):
        req = navigation_action.get_request()
        url = req.get_uri() if req else None
        return self.create_tab(url, switch_to=True)

    def on_run_file_chooser(self, web_view, request):
        dialog = Gtk.FileChooserNative.new(
            "Select File to Upload",
            self,
            Gtk.FileChooserAction.OPEN,
            "_Open",
            "_Cancel"
        )
        dialog.set_select_multiple(request.get_select_multiple())

        filter_obj = request.get_mime_types_filter()
        if filter_obj:
            dialog.add_filter(filter_obj)
        else:
            all_filter = Gtk.FileFilter()
            all_filter.set_name("All Files")
            all_filter.add_pattern("*")
            dialog.add_filter(all_filter)

        res = dialog.run()
        if res == Gtk.ResponseType.ACCEPT:
            filenames = dialog.get_filenames()
            if filenames:
                request.select_files(filenames)
            else:
                request.cancel()
        else:
            request.cancel()
        dialog.destroy()
        return True

    def is_video_stream_url(self, url: str) -> bool:
        if not url:
            return False
        p = urllib.parse.urlparse(url)
        h = p.netloc.lower()
        path = p.path.lower()
        if "youtu.be" in h and len(path) > 1:
            return True
        if "youtube.com" in h and path.startswith(("/watch", "/shorts/", "/live/", "/embed/")):
            return True
        if any(v in h for v in ("twitch.tv", "vimeo.com", "odysee.com", "bilibili.com")) and len(path.strip("/")) > 0:
            return True
        if path.endswith((".mp4", ".webm", ".mkv", ".m3u8")):
            return True
        return False

    def on_decide_policy(self, web_view, decision, decision_type):
        if decision_type in (WebKit.PolicyDecisionType.NAVIGATION_ACTION, WebKit.PolicyDecisionType.NEW_WINDOW_ACTION):
            nav_action = decision.get_navigation_action()
            req = nav_action.get_request()
            uri = req.get_uri() if req else ""
            if self.is_video_stream_url(uri):
                wf_media = REPO_ROOT / "bin" / "wf-media"
                subprocess.Popen([str(wf_media), uri], start_new_session=True)
                self.set_status_notification("🎬 Handed video to wf-media (mpv)")
                decision.ignore()
                if self.notebook.get_n_pages() <= 1 and (not web_view.get_uri() or uri == web_view.get_uri()):
                    GLib.idle_add(self.on_quit)
                elif not web_view.get_uri():
                    self.close_tab_for_view(web_view)
                return True

        if decision_type == WebKit.PolicyDecisionType.NEW_WINDOW_ACTION:
            nav_action = decision.get_navigation_action()
            req = nav_action.get_request()
            if req and req.get_uri():
                self.create_tab(req.get_uri(), switch_to=True)
            decision.ignore()
            return True
        return False

    def try_autofill(self, domain=None):
        target_domain = domain or self.root_domain
        creds = self.vault.get_credentials(target_domain)
        if creds:
            u, p = creds
            js = f"if (window.__wf_autofill) window.__wf_autofill({json.dumps(u)}, {json.dumps(p)});"
            self.eval_js(js)
            self.set_status_notification(f"🔐 Autofilled: {u}")

    def set_status_notification(self, text: str):
        self.status_notification = text
        self.update_title()
        GLib.timeout_add_seconds(3, self._clear_status_notification)

    def _clear_status_notification(self):
        self.status_notification = ""
        self.update_title()
        return False

    def prompt_save_credentials(self, domain: str, username: str, password: str):
        self.pending_credentials = (domain, username, password)
        display_user = f"'{username}' " if username else ""
        self.infobar_label.set_text(f"🔐 Save password for {display_user}on {domain}?")
        self.infobar.show()

    def on_infobar_response(self, infobar, response_id):
        if response_id == Gtk.ResponseType.ACCEPT and self.pending_credentials:
            d, u, p = self.pending_credentials
            user_to_save = u if u else "user"
            self.vault.save_credentials(d, user_to_save, p)
            self.set_status_notification(f"🔐 Saved login for {user_to_save}")
        elif response_id == Gtk.ResponseType.REJECT and self.pending_credentials:
            d, _, _ = self.pending_credentials
            self.vault.ignore_domain(d)
            self.set_status_notification(f"[-] Never save for {d}")
        self.pending_credentials = None
        self.infobar.hide()

    def eval_js(self, script: str, view: WebKit.WebView = None):
        target = view or self.current_web_view
        if not target:
            return
        if hasattr(target, "evaluate_javascript"):
            target.evaluate_javascript(script, -1, None, None, None, None, None)
        else:
            target.run_javascript(script, None, None, None)

    def update_title(self):
        view = self.current_web_view
        page_title = (view.get_title() if view else "") or self.root_domain
        wb_tag = f" [WB:{self.workbench}]" if self.workbench else ""
        reader_tag = " [READER-SYNC]" if self.from_reader else ""
        search_tag = f" [/{self.search_text}]" if self.mode == "SEARCH" else ""
        notif_tag = f" [{self.status_notification}]" if self.status_notification else ""

        cur_tab = self.notebook.get_current_page() + 1
        total_tabs = self.notebook.get_n_pages()
        tab_tag = f" [{cur_tab}/{total_tabs}]" if total_tabs > 1 else ""

        self.set_title(f"wf-view [{self.mode}]{tab_tag}{wb_tag}{reader_tag}{search_tag}{notif_tag} (@{self.root_domain}) - {page_title}")

    def on_title_changed(self, view, param):
        title = view.get_title() or view.get_uri() or "Tab"
        if hasattr(view, "_tab_label"):
            view._tab_label.set_text(title[:25])
            view._tab_label.set_tooltip_text(title)
        if view == self.current_web_view:
            self.update_title()
            uri = view.get_uri()
            if title and uri:
                self.update_history_title(uri, title)

    def update_history_title(self, uri: str, title: str):
        hist_jsonl = self.base_share / "history.jsonl"
        if not hist_jsonl.exists():
            return
        try:
            lines = hist_jsonl.read_text(encoding="utf-8").splitlines()
            if not lines:
                return
            last = json.loads(lines[-1])
            if last.get("url") == uri or self.root_domain in last.get("url", ""):
                last["title"] = title
                lines[-1] = json.dumps(last)
                hist_jsonl.write_text("\n".join(lines) + "\n", encoding="utf-8")
        except Exception:
            pass

    def on_uri_changed(self, view, param):
        if view == self.current_web_view:
            self.update_title()

    def on_js_message(self, manager, js_result):
        try:
            if hasattr(js_result, "get_js_value"):
                val = js_result.get_js_value().to_string()
            else:
                val = js_result.get_value().to_string()
            data = json.loads(val) if val.startswith("{") else {"action": "set_mode", "mode": val}
            action = data.get("action")
            if action == "set_mode":
                self.mode = data.get("mode", "NORMAL")
                self.update_title()
            elif action == "hints_dismissed":
                if self.mode == "HINTS":
                    self.mode = "NORMAL"
                    self.update_title()
            elif action == "open_tab":
                target_url = data.get("url")
                if target_url:
                    self.create_tab(target_url, switch_to=True)
            elif action == "request_autofill":
                dom = data.get("domain") or self.root_domain
                self.try_autofill(dom)
            elif action == "credentials_detected":
                dom = data.get("domain") or self.root_domain
                u = data.get("username", "").strip()
                pwd = data.get("password", "")
                if pwd and not self.vault.is_domain_ignored(dom):
                    existing = self.vault.get_credentials(dom)
                    if not existing or existing[1] != pwd or (u and existing[0] != u):
                        self.prompt_save_credentials(dom, u, pwd)
        except Exception:
            pass

    def setup_keybindings(self):
        self.connect("key-press-event", self.on_key_press)

    def on_key_press(self, widget, event):
        keyname = Gdk.keyval_name(event.keyval)
        if not keyname:
            return False

        if self.infobar.get_visible():
            if keyname in ("y", "Y"):
                self.on_infobar_response(self.infobar, Gtk.ResponseType.ACCEPT)
                return True
            elif keyname in ("n", "N"):
                self.on_infobar_response(self.infobar, Gtk.ResponseType.REJECT)
                return True
            elif keyname == "Escape":
                self.on_infobar_response(self.infobar, Gtk.ResponseType.CLOSE)
                return True

        if keyname == "Escape":
            if self.omnibar_box.get_visible():
                self.close_omnibar()
                return True
            self.mode = "NORMAL"
            self.pending_g = False
            self.pending_number = None
            if self.find_controller:
                self.find_controller.search_finish()
            self.eval_js(
                "if (document.activeElement) document.activeElement.blur(); "
                "if (window.__wf_cleanup_hints) window.__wf_cleanup_hints();"
            )
            self.update_title()
            return True

        # Alt+1..9 for direct tab switching
        if (event.state & Gdk.ModifierType.MOD1_MASK) and keyname in "123456789":
            target = int(keyname) - 1
            if target < self.notebook.get_n_pages():
                self.notebook.set_current_page(target)
            return True

        # Wayland image paste (Ctrl+v): bridges Wayland screenshot/image offers into DOM File/Blob
        if (event.state & Gdk.ModifierType.CONTROL_MASK) and keyname in ("v", "V"):
            if self.paste_clipboard_image():
                return True

        if self.mode == "SEARCH":
            if keyname in ("Return", "KP_Enter"):
                self.mode = "NORMAL"
                if self.search_text and self.find_controller:
                    self.find_controller.search(
                        self.search_text,
                        WebKit.FindOptions.CASE_INSENSITIVE | WebKit.FindOptions.WRAP_AROUND,
                        1000
                    )
                self.update_title()
            elif keyname == "BackSpace":
                self.search_text = self.search_text[:-1]
                self.update_title()
            elif len(keyname) == 1 and 32 <= event.keyval <= 126:
                self.search_text += chr(event.keyval)
                self.update_title()
            elif keyname == "space":
                self.search_text += " "
                self.update_title()
            return True

        if self.mode in ("INSERT", "HINTS"):
            return False

        # Vim Tab switching: gt (next), gT (prev), 1..9gt (tab N)
        if self.pending_g:
            if keyname == "t":
                if self.pending_number is not None:
                    target = max(0, min(self.notebook.get_n_pages() - 1, self.pending_number - 1))
                    self.notebook.set_current_page(target)
                    self.pending_number = None
                else:
                    cur = self.notebook.get_current_page()
                    total = self.notebook.get_n_pages()
                    if total > 1:
                        self.notebook.set_current_page((cur + 1) % total)
                self.pending_g = False
                return True
            elif keyname == "T":
                cur = self.notebook.get_current_page()
                total = self.notebook.get_n_pages()
                if total > 1:
                    self.notebook.set_current_page((cur - 1) % total)
                self.pending_g = False
                self.pending_number = None
                return True
            elif keyname == "g":
                self.eval_js("window.scrollTo({top: 0, behavior: 'smooth'});")
                self.pending_g = False
                self.pending_number = None
                return True
            else:
                self.pending_g = False
                self.pending_number = None

        if keyname in "123456789":
            self.pending_number = int(keyname)
            # Give a brief window to press 'g' 't'
            return True

        if keyname == "g":
            self.pending_g = True
            return True

        view = self.current_web_view
        if not view:
            return False

        if keyname == "j":
            self.eval_js("window.scrollBy({top: 120, behavior: 'smooth'});")
            return True
        elif keyname == "k":
            self.eval_js("window.scrollBy({top: -120, behavior: 'smooth'});")
            return True
        elif keyname == "d":
            self.eval_js("window.scrollBy({top: window.innerHeight * 0.5, behavior: 'smooth'});")
            return True
        elif keyname == "u":
            self.eval_js("window.scrollBy({top: -window.innerHeight * 0.5, behavior: 'smooth'});")
            return True
        elif keyname == "G":
            self.eval_js("window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'});")
            return True
        elif keyname == "H":
            if view.can_go_back():
                view.go_back()
            return True
        elif keyname == "L":
            if view.can_go_forward():
                view.go_forward()
            return True
        elif keyname == "r":
            view.reload()
            return True
        elif keyname == "R":
            view.reload_bypass_cache()
            return True
        elif keyname == "o":
            self.open_omnibar(new_tab=False)
            return True
        elif keyname in ("O", "t"):
            self.open_omnibar(new_tab=True)
            return True
        elif keyname == "x":
            self.close_current_tab()
            return True
        elif keyname == "slash":
            self.mode = "SEARCH"
            self.search_text = ""
            self.update_title()
            return True
        elif keyname == "n":
            if self.search_text and self.find_controller:
                self.find_controller.search_next()
            return True
        elif keyname == "N":
            if self.search_text and self.find_controller:
                self.find_controller.search_previous()
            return True
        elif keyname in ("plus", "equal"):
            view.set_zoom_level(view.get_zoom_level() + 0.1)
            return True
        elif keyname == "minus":
            view.set_zoom_level(max(0.3, view.get_zoom_level() - 0.1))
            return True
        elif keyname == "0":
            view.set_zoom_level(1.0)
            return True
        elif keyname in ("E", "e"):
            if self.from_reader:
                self.on_quit()
                return True
            uri = view.get_uri() or self.initial_urls[0]
            wf_reader = Path(__file__).resolve().parent / "wf-reader"
            subprocess.Popen(["kitty", "-e", str(wf_reader), uri])
            self.on_quit()
            return True
        elif keyname == "b":
            self.bookmark_current()
            return True
        elif keyname == "y":
            self.copy_url_to_clipboard()
            return True
        elif keyname == "q":
            self.on_quit()
            return True
        elif keyname == "i":
            self.mode = "INSERT"
            self.update_title()
            return True
        elif keyname == "f":
            self.trigger_hints(new_tab=False)
            return True
        elif keyname in ("T", "F"):
            self.trigger_hints(new_tab=True)
            return True
        elif keyname == "p":
            creds = self.vault.get_credentials(self.root_domain)
            if creds:
                u, pwd = creds
                self.eval_js(f"if (window.__wf_autofill) window.__wf_autofill({json.dumps(u)}, {json.dumps(pwd)});")
                self.set_status_notification(f"🔐 Autofilled: {u}")
            else:
                self.set_status_notification(f"[-] No saved login for {self.root_domain}")
            return True
        elif keyname == "P":
            self.eval_js("if (window.__wf_capture_credentials) window.__wf_capture_credentials();")
            return True
        elif keyname in ("M", "m"):
            uri = view.get_uri() or self.initial_urls[0]
            wf_media = REPO_ROOT / "bin" / "wf-media"
            subprocess.Popen([str(wf_media), uri], start_new_session=True)
            self.set_status_notification("🎬 Launched in wf-media (mpv)")
            return True

        self.pending_g = False
        self.pending_number = None
        return False

    def trigger_hints(self, new_tab: bool = False):
        if not self.hints_script_path.exists():
            return
        try:
            hints_js = self.hints_script_path.read_text(encoding="utf-8")
            self.mode = "HINTS"
            self.update_title()
            prefix = f"window.__wf_hint_new_tab = {'true' if new_tab else 'false'}; "
            self.eval_js(prefix + hints_js)
        except Exception as e:
            log_error(f"Failed to inject hints: {e}")

    def bookmark_current(self):
        view = self.current_web_view
        uri = (view.get_uri() if view else "") or self.initial_urls[0]
        title = (view.get_title() if view else "") or self.root_domain
        self.bookmarks_file.parent.mkdir(parents=True, exist_ok=True)
        with open(self.bookmarks_file, "a", encoding="utf-8") as f:
            f.write(f"{uri} | {title} | general\n")
        self.set_status_notification("★ Bookmarked current tab")

    def copy_url_to_clipboard(self):
        view = self.current_web_view
        uri = (view.get_uri() if view else "") or self.initial_urls[0]
        try:
            proc = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE)
            proc.communicate(input=uri.encode("utf-8"))
        except FileNotFoundError:
            clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            clipboard.set_text(uri, -1)
        self.set_status_notification("📋 Copied URL to clipboard")

    def get_wayland_clipboard_image(self) -> tuple[str, str] | None:
        try:
            types_proc = subprocess.run(
                ["wl-paste", "-l"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=0.5
            )
            if types_proc.returncode == 0:
                types = types_proc.stdout.splitlines()
                for mime in ("image/png", "image/jpeg", "image/webp"):
                    if mime in types:
                        img_proc = subprocess.run(
                            ["wl-paste", "--type", mime],
                            stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL,
                            timeout=1.5
                        )
                        if img_proc.returncode == 0 and img_proc.stdout:
                            b64 = base64.b64encode(img_proc.stdout).decode("ascii")
                            return (mime, b64)
        except Exception:
            pass
        return None

    def paste_clipboard_image(self) -> bool:
        img_info = self.get_wayland_clipboard_image()
        if not img_info:
            return False
        mime, b64 = img_info
        ext = "png" if "png" in mime else ("jpg" if "jpeg" in mime else "webp")
        filename = f"screenshot_{int(time.time())}.{ext}"

        js_paste = f"""
        (function() {{
            try {{
                const b64 = "{b64}";
                const mime = "{mime}";
                const filename = "{filename}";
                const binStr = atob(b64);
                const len = binStr.length;
                const bytes = new Uint8Array(len);
                for (let i = 0; i < len; i++) {{
                    bytes[i] = binStr.charCodeAt(i);
                }}
                const file = new File([bytes], filename, {{ type: mime, lastModified: Date.now() }});

                let target = document.activeElement;
                if (!target || target === document.body || target.tagName === 'BODY') {{
                    target = document.querySelector('rich-textarea [contenteditable="true"]') ||
                             document.querySelector('[contenteditable="true"]') ||
                             document.querySelector('textarea:not([hidden])') ||
                             document.querySelector('input[type="file"]') ||
                             document.querySelector('form') ||
                             document.body;
                }}

                const dt = new DataTransfer();
                dt.items.add(file);

                // 1. Dispatch synthetic ClipboardEvent
                const pasteEvt = new ClipboardEvent('paste', {{
                    bubbles: true,
                    cancelable: true,
                    composed: true,
                    clipboardData: dt
                }});
                target.dispatchEvent(pasteEvt);

                // 2. Dispatch DragEvent 'drop' for dropzone uploaders (Gemini prompt container)
                const dropEvt = new DragEvent('drop', {{
                    bubbles: true,
                    cancelable: true,
                    composed: true,
                    dataTransfer: dt
                }});
                const dropTarget = target.closest('form') || target.closest('rich-textarea') || target;
                dropTarget.dispatchEvent(dropEvt);

                // 3. Assign directly to file input if present in active container
                const fileInputs = document.querySelectorAll('input[type="file"]');
                for (const fi of fileInputs) {{
                    try {{
                        fi.files = dt.files;
                        fi.dispatchEvent(new Event('change', {{ bubbles: true }}));
                    }} catch (e) {{}}
                }}
                return true;
            }} catch (err) {{
                console.error("Webflow paste image error:", err);
                return false;
            }}
        }})();
        """
        self.eval_js(js_paste)
        self.set_status_notification("📷 Pasted screenshot from clipboard")
        return True

    def sync_workbench_on_exit(self):
        if not self.wb_manifest or not self.wb_manifest.exists():
            return
        try:
            now = time.strftime("%Y-%m-%d %H:%M:%S")
            tabs = []
            for i in range(self.notebook.get_n_pages()):
                view = self.notebook.get_nth_page(i)
                uri = view.get_uri()
                title = view.get_title() or uri
                if uri:
                    tabs.append({"url": uri, "title": title, "updated_at": now})
            if tabs:
                data = json.loads(self.wb_manifest.read_text(encoding="utf-8"))
                data["tabs"] = tabs
                data["updated_at"] = now
                self.wb_manifest.write_text(json.dumps(data, indent=2), encoding="utf-8")
        except Exception:
            pass

    def on_quit(self, *args):
        self.sync_workbench_on_exit()
        self.destroy()
        Gtk.main_quit()


def GObject_new_webview(web_context, ucm):
    from gi.repository import GObject
    return GObject.new(
        WebKit.WebView,
        web_context=web_context,
        user_content_manager=ucm
    )


def main():
    parser = argparse.ArgumentParser(description="Webflow Tier 3 WebKitGTK Viewer")
    parser.add_argument("urls", nargs="+", help="Target URL(s) to open as tabs")
    parser.add_argument("--workbench", "-w", default=None, help="Bind to named workbench session")
    parser.add_argument("--from-reader", action="store_true", help="Escalated from interactive terminal reader")
    args = parser.parse_args()

    try:
        app = WebflowViewer(args.urls, workbench=args.workbench, from_reader=args.from_reader)
        Gtk.main()
    except Exception:
        log_error(traceback.format_exc())
        sys.exit(1)


if __name__ == "__main__":
    main()
