#!/usr/bin/env python3
"""
wf-reader - Tier 1: Terminal Markdown Extractor & Typeset Terminal Reader for Webflow
Extracts semantic text from web pages into clean Markdown and renders formatted ANSI typography.
Features centered single-page layout, dual-pane side-by-side split view, isolated pane scrolling,
and mouse hover/scroll support.
"""
import os
import sys
import re
import html
import shutil
import textwrap
import curses
import urllib.request
import urllib.parse
import subprocess
from pathlib import Path
from html.parser import HTMLParser

VOID_TAGS = {
    "area", "base", "br", "col", "embed", "hr", "img", "input",
    "link", "meta", "param", "source", "track", "wbr"
}


class SemanticHTMLToMarkdown(HTMLParser):
    def __init__(self, base_url="", keep_nav_links=False):
        super().__init__()
        self.base_url = base_url
        self.output = []
        self.title = ""
        self.in_title = False
        self.in_pre = False
        self.ignored_tags = {
            "script", "style", "footer", "aside",
            "noscript", "iframe", "svg", "button", "form"
        }
        if not keep_nav_links:
            self.ignored_tags.update({"nav", "header", "figure", "figcaption"})
        self.ignore_stack = []
        self.current_href = None
        self.current_link_text = []

    def handle_starttag(self, tag, attrs):
        attrs_dict = dict(attrs)
        tag_lower = tag.lower()
        is_void = tag_lower in VOID_TAGS

        if self.ignore_stack:
            if not is_void:
                self.ignore_stack.append(tag_lower)
            return

        if tag_lower in self.ignored_tags:
            if not is_void:
                self.ignore_stack.append(tag_lower)
            return

        class_id = (
            attrs_dict.get("class", "") + " " +
            attrs_dict.get("id", "") + " " +
            attrs_dict.get("role", "")
        ).lower()
        noise_tokens = [
            "advert", "sidebar", "cookie", "consent", "footer", "menu",
            "mw-editsection", "reflist", "reference", "catlinks",
            "vector-header", "vector-page-toolbar", "vector-column-start",
            "mw-jump-link", "printfooter", "noprint", "ambox", "hatnote",
            "navbox", "sisterproject"
        ]
        if any(tok in class_id for tok in noise_tokens):
            if not is_void:
                self.ignore_stack.append(tag_lower)
            return

        if tag_lower == "title":
            self.in_title = True
        elif tag_lower in ["h1", "h2", "h3", "h4", "h5", "h6"]:
            level = int(tag_lower[1])
            self.output.append(f"\n\n{'#' * level} ")
        elif tag_lower in ["p", "div", "section", "article"]:
            self.output.append("\n\n")
        elif tag_lower == "blockquote":
            self.output.append("\n\n> ")
        elif tag_lower == "br":
            self.output.append("\n")
        elif tag_lower in ["li", "dt", "dd"]:
            self.output.append("\n* ")
        elif tag_lower in ["tr"]:
            self.output.append("\n")
        elif tag_lower in ["td", "th"]:
            self.output.append("  ")
        elif tag_lower in ["strong", "b"]:
            self.output.append(" **")
        elif tag_lower in ["em", "i"]:
            self.output.append(" *")
        elif tag_lower == "code" and not self.in_pre:
            self.output.append(" `")
        elif tag_lower == "pre":
            self.in_pre = True
            self.output.append("\n\n```\n")
        elif tag_lower == "a":
            href = attrs_dict.get("href", "")
            if href and not href.startswith(("#", "javascript:")):
                self.current_href = urllib.parse.urljoin(self.base_url, href)
                self.current_link_text = []

    def handle_endtag(self, tag):
        tag_lower = tag.lower()
        if self.ignore_stack:
            if self.ignore_stack[-1] == tag_lower:
                self.ignore_stack.pop()
            return

        if tag_lower == "title":
            self.in_title = False
        elif tag_lower == "pre":
            self.in_pre = False
            self.output.append("\n```\n\n")
        elif tag_lower in ["strong", "b"]:
            self.output.append("** ")
        elif tag_lower in ["em", "i"]:
            self.output.append("* ")
        elif tag_lower == "code" and not self.in_pre:
            self.output.append("` ")
        elif tag_lower == "a" and self.current_href:
            link_text = "".join(self.current_link_text).strip()
            if link_text:
                self.output.append(f" [{link_text}]({self.current_href}) ")
            self.current_href = None
            self.current_link_text = []

    def handle_data(self, data):
        if self.ignore_stack:
            return
        if self.in_title:
            self.title += data
            return
        if self.current_href is not None:
            self.current_link_text.append(data)
        else:
            self.output.append(data)

    def get_markdown(self):
        raw = "".join(self.output)
        raw = re.sub(r"\n{3,}", "\n\n", raw)
        lines = [line.strip() for line in raw.splitlines()]
        clean = "\n".join(lines).strip()
        return clean, self.title.strip()


def format_links_for_reading(md_text: str, base_url: str):
    links = []
    counter = 0

    def repl(match):
        nonlocal counter
        text = match.group(1).strip()
        href = match.group(2).strip()
        if not text or href.startswith(("#", "javascript:")):
            return text
        if re.match(r"^\[?\d+\]?$", text) or text.lower() in ("edit", "edit source"):
            return ""
        full_url = urllib.parse.urljoin(base_url, href)
        counter += 1
        links.append((counter, text, full_url))
        return f"**{text}** `[{counter}]`"

    cleaned = re.sub(r" `\[\d+\]`", "", md_text)
    processed = re.sub(r"\[([^\[\]]+)\]\(([^)\s]+)\)", repl, cleaned)
    return processed, links


def render_markdown_to_ansi(title: str, url: str, md_text: str, links: list, width: int = 80) -> str:
    width = max(35, width)
    pad = ""

    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    ITALIC = "\033[3m"
    CYAN = "\033[36m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    MAGENTA = "\033[35m"

    def style_inline(line: str) -> str:
        line = re.sub(r"`\[(\d+)\]`", f"{YELLOW}[\\1]{RESET}", line)
        line = re.sub(r"`([^`]+)`", f"{MAGENTA}\\1{RESET}", line)
        line = re.sub(r"\*\*([^*]+)\*\*", f"{BOLD}{CYAN}\\1{RESET}", line)
        line = re.sub(r"\*([^*]+)\*", f"{ITALIC}\\1{RESET}", line)
        return line

    out = []
    out.append("")
    out.append(f"{pad}{BOLD}{CYAN}┏{'━' * (width - 2)}┓{RESET}")
    wrap_w = max(10, width - 6)
    for t_line in textwrap.wrap(title, width=wrap_w) or [title]:
        out.append(f"{pad}{BOLD}{CYAN}┃{RESET}  {BOLD}{t_line.ljust(wrap_w)}{RESET}  {BOLD}{CYAN}┃{RESET}")
    out.append(f"{pad}{BOLD}{CYAN}┗{'━' * (width - 2)}┛{RESET}")
    out.append(f"{pad}{DIM}Source: {url}{RESET}")
    out.append(f"{pad}{DIM}{'─' * width}{RESET}\n")

    paragraphs = md_text.split("\n\n")

    for block in paragraphs:
        block = block.strip()
        if not block:
            continue

        if block.startswith("```"):
            lines = block.splitlines()
            out.append(f"{pad}{DIM}┌── code {'─' * max(2, width - 10)}┐{RESET}")
            for cl in lines[1:]:
                if cl.strip() == "```":
                    continue
                out.append(f"{pad}{DIM}│{RESET} {MAGENTA}{cl[:width - 4]}{RESET}")
            out.append(f"{pad}{DIM}└{'─' * max(2, width - 2)}┘{RESET}\n")
            continue

        if block.startswith("#"):
            m = re.match(r"^(#+)\s*(.*)", block, re.DOTALL)
            if m:
                level = len(m.group(1))
                h_text = " ".join(m.group(2).split())
                h_text = re.sub(r"\*\*([^*]+)\*\*", r"\1", h_text)
                h_text = re.sub(r"`\[\d+\]`", "", h_text).strip()
                if not h_text:
                    continue
                if level == 1:
                    out.append(f"\n{pad}{BOLD}{GREEN}██ {h_text.upper()}{RESET}")
                    out.append(f"{pad}{GREEN}{'═' * min(len(h_text) + 3, width)}{RESET}\n")
                elif level == 2:
                    out.append(f"\n{pad}{BOLD}{CYAN}▌ {h_text}{RESET}")
                    out.append(f"{pad}{DIM}{'─' * min(len(h_text) + 2, width)}{RESET}\n")
                else:
                    out.append(f"\n{pad}{BOLD}{YELLOW}• {h_text}{RESET}\n")
                continue

        if block.startswith("* ") or block.startswith("- "):
            for item in block.splitlines():
                item_clean = re.sub(r"^[\*\-]\s+", "", item.strip())
                if not item_clean:
                    continue
                wrapped = textwrap.wrap(item_clean, width=max(10, width - 4))
                for idx, wline in enumerate(wrapped):
                    prefix = f"{pad}  {CYAN}•{RESET} " if idx == 0 else f"{pad}    "
                    out.append(prefix + style_inline(wline))
            out.append("")
            continue

        if block.startswith(">"):
            q_clean = re.sub(r"^>\s*", "", block, flags=re.MULTILINE)
            for wline in textwrap.wrap(q_clean, width=max(10, width - 4)):
                out.append(f"{pad}{YELLOW}│{RESET} {ITALIC}{style_inline(wline)}{RESET}")
            out.append("")
            continue

        wrapped = textwrap.wrap(block, width=width)
        for wline in wrapped:
            out.append(f"{pad}{style_inline(wline)}")
        out.append("")

    if links:
        out.append(f"\n{pad}{BOLD}{CYAN}▌ Hyperlink Reference Index (Type 1..{len(links)}){RESET}")
        out.append(f"{pad}{DIM}{'─' * width}{RESET}")
        for num, ltext, lurl in links[:60]:
            short_t = (ltext[:24] + "…") if len(ltext) > 25 else ltext
            short_u = (lurl[:max(10, width - 36)] + "…") if len(lurl) > max(10, width - 35) else lurl
            out.append(f"{pad}{YELLOW}[{num:2d}]{RESET} {BOLD}{short_t:<26}{RESET} {DIM}{short_u}{RESET}")
        if len(links) > 60:
            out.append(f"{pad}{DIM}... and {len(links) - 60} more links.{RESET}")
        out.append("")

    return "\n".join(out)


def resolve_url_or_search(query: str) -> str:
    query = query.strip()
    if not query:
        return None
    if "://" in query:
        return query
    if "." in query and " " not in query:
        return f"https://{query}"
    try:
        headers = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0"}
        data = urllib.parse.urlencode({"q": query}).encode("utf-8")
        req = urllib.request.Request("https://lite.duckduckgo.com/lite/", data=data, headers=headers)
        with urllib.request.urlopen(req, timeout=5) as resp:
            html_text = resp.read().decode("utf-8", errors="replace")
        links = re.findall(r'<a[^>]+href=[\'\"](https?://[^\'\"]+)[\'\"][^>]*class=[\'\"]result-link[\'\"]', html_text)
        if links:
            return links[0]
    except Exception:
        pass
    return f"https://duckduckgo.com/lite/?q={urllib.parse.quote_plus(query)}"


def extract_content(url: str):
    parsed = urllib.parse.urlparse(url)
    if parsed.netloc in ("www.wikipedia.org", "wikipedia.org") and parsed.path in ("", "/"):
        url = "https://en.wikipedia.org/wiki/Main_Page"

    headers = {
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0"
    }
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=10) as resp:
        raw_html = resp.read().decode("utf-8", errors="replace")

    try:
        import trafilatura
        extracted = trafilatura.extract(
            raw_html,
            include_links=True,
            include_tables=False,
            output_format="markdown"
        )
        if extracted and len(extracted) > 400:
            meta = trafilatura.extract_metadata(raw_html)
            title = (meta.title if meta and meta.title else None) or url
            md_clean, links = format_links_for_reading(extracted, url)
            return md_clean, title, links, url
    except ImportError:
        pass

    body_html = raw_html
    for pattern in [
        r'<div[^>]+id=["\']mw-content-text["\'][^>]*>(.*?)<div class=["\']printfooter["\']',
        r'<main[^>]*>(.*?)</main>',
        r'<article[^>]*>(.*?)</article>'
    ]:
        m = re.search(pattern, raw_html, re.DOTALL | re.IGNORECASE)
        if m and len(m.group(1)) > 400:
            body_html = m.group(1)
            break

    title_m = re.search(r"<title[^>]*>(.*?)</title>", raw_html, re.DOTALL | re.IGNORECASE)
    doc_title = html.unescape(re.sub(r"<[^>]+>", "", title_m.group(1)).strip()) if title_m else url

    parser = SemanticHTMLToMarkdown(base_url=url, keep_nav_links=False)
    parser.feed(body_html)
    raw_md, parsed_title = parser.get_markdown()

    if len(raw_md) < 200:
        parser2 = SemanticHTMLToMarkdown(base_url=url, keep_nav_links=True)
        parser2.feed(raw_html)
        raw_md, parsed_title = parser2.get_markdown()

    final_title = parsed_title or doc_title
    md_clean, links = format_links_for_reading(raw_md, url)
    return md_clean, final_title, links, url


def bookmark(url: str, title: str):
    bm_file = Path.home() / ".local" / "share" / "webflow" / "bookmarks.txt"
    bm_file.parent.mkdir(parents=True, exist_ok=True)
    with open(bm_file, "a", encoding="utf-8") as f:
        f.write(f"{url} | {title} | general\n")


ANSI_SPLIT_RE = re.compile(r"(\033\[[0-9;]*m)")

def parse_ansi_line(line: str):
    segments = []
    attr = curses.A_NORMAL
    parts = ANSI_SPLIT_RE.split(line)
    for part in parts:
        if not part:
            continue
        if part.startswith("\033["):
            code = part[2:-1]
            if code == "0":
                attr = curses.A_NORMAL
            elif code == "1":
                attr |= curses.A_BOLD
            elif code == "2":
                attr |= curses.A_DIM
            elif code == "3":
                attr |= getattr(curses, "A_ITALIC", curses.A_NORMAL)
            elif code == "36":
                attr = (attr & ~curses.A_COLOR) | curses.color_pair(1)
            elif code == "32":
                attr = (attr & ~curses.A_COLOR) | curses.color_pair(2)
            elif code == "33":
                attr = (attr & ~curses.A_COLOR) | curses.color_pair(3)
            elif code == "35":
                attr = (attr & ~curses.A_COLOR) | curses.color_pair(4)
        else:
            segments.append((part, attr))
    return segments


def ensure_buffer_rendered(buf, width):
    if buf.get("rendered_width") != width:
        ansi_text = render_markdown_to_ansi(buf["title"], buf["url"], buf["md_text"], buf["links"], width=width)
        buf["parsed_lines"] = [parse_ansi_line(l) for l in ansi_text.splitlines()]
        buf["rendered_width"] = width


def run_interactive_reader(initial_buffers: list):
    buffers = initial_buffers
    active_pane = 0

    def _curses_reader(stdscr):
        nonlocal active_pane, buffers
        try:
            curses.curs_set(0)
        except curses.error:
            pass

        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        except Exception:
            pass

        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            curses.init_pair(2, curses.COLOR_GREEN, -1)
            curses.init_pair(3, curses.COLOR_YELLOW, -1)
            curses.init_pair(4, curses.COLOR_MAGENTA, -1)
            curses.init_pair(5, curses.COLOR_BLACK, curses.COLOR_CYAN)

        link_buf = ""
        link_open_split = False
        link_prompt = False
        split_prompt = False
        split_buf = ""
        status_note = ""

        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            view_h = max(1, h - 3)

            if len(buffers) == 1:
                active_pane = 0
                buf = buffers[0]
                col_w = min(88, max(45, w - 8))
                margin_left = max(0, (w - col_w) // 2)
                ensure_buffer_rendered(buf, col_w)

                max_scroll = max(0, len(buf["parsed_lines"]) - view_h)
                buf["scroll_y"] = max(0, min(buf["scroll_y"], max_scroll))
                pct = int((buf["scroll_y"] / max_scroll) * 100) if max_scroll > 0 else 100
                pos_label = "TOP" if buf["scroll_y"] == 0 else ("BOT" if buf["scroll_y"] >= max_scroll else f"{pct:2d}%")

                top_bar = f" 📖 {buf['title'][:col_w - 14]} [{pos_label}] "
                try:
                    stdscr.addstr(0, margin_left, top_bar.ljust(col_w)[:col_w], curses.color_pair(5) | curses.A_BOLD)
                except curses.error:
                    pass

                for r in range(view_h):
                    line_idx = buf["scroll_y"] + r
                    if line_idx >= len(buf["parsed_lines"]):
                        break
                    x = 0
                    for text_seg, attr in buf["parsed_lines"][line_idx]:
                        if x >= col_w:
                            break
                        clipped = text_seg[: max(0, col_w - x)]
                        try:
                            stdscr.addstr(r + 1, margin_left + x, clipped, attr)
                        except curses.error:
                            pass
                        x += len(clipped)

            else:
                pane_w = (w - 1) // 2

                # Left Pane (Pane 0)
                buf0 = buffers[0]
                col_w0 = max(25, pane_w - 4)
                ensure_buffer_rendered(buf0, col_w0)
                max_scroll0 = max(0, len(buf0["parsed_lines"]) - view_h)
                buf0["scroll_y"] = max(0, min(buf0["scroll_y"], max_scroll0))
                pct0 = int((buf0["scroll_y"] / max_scroll0) * 100) if max_scroll0 > 0 else 100
                pos0 = "TOP" if buf0["scroll_y"] == 0 else ("BOT" if buf0["scroll_y"] >= max_scroll0 else f"{pct0:2d}%")

                is_act0 = (active_pane == 0)
                tag0 = " [ACTIVE] " if is_act0 else " "
                style0 = (curses.color_pair(5) | curses.A_BOLD) if is_act0 else (curses.color_pair(1) | curses.A_DIM)
                banner0 = f" [1/2]{tag0}{buf0['title'][:pane_w - 18]} [{pos0}] "
                try:
                    stdscr.addstr(0, 0, banner0.ljust(pane_w)[:pane_w], style0)
                except curses.error:
                    pass

                for r in range(view_h):
                    line_idx = buf0["scroll_y"] + r
                    if line_idx >= len(buf0["parsed_lines"]):
                        break
                    x = 0
                    for text_seg, attr in buf0["parsed_lines"][line_idx]:
                        if x >= col_w0:
                            break
                        clipped = text_seg[: max(0, col_w0 - x)]
                        try:
                            stdscr.addstr(r + 1, 2 + x, clipped, attr)
                        except curses.error:
                            pass
                        x += len(clipped)

                # Vertical Divider line
                div_attr = curses.color_pair(1) | curses.A_DIM
                for r in range(0, view_h + 1):
                    try:
                        stdscr.addstr(r, pane_w, "│", div_attr)
                    except curses.error:
                        pass

                # Right Pane (Pane 1)
                buf1 = buffers[1]
                right_w = w - pane_w - 1
                col_w1 = max(25, right_w - 4)
                ensure_buffer_rendered(buf1, col_w1)
                max_scroll1 = max(0, len(buf1["parsed_lines"]) - view_h)
                buf1["scroll_y"] = max(0, min(buf1["scroll_y"], max_scroll1))
                pct1 = int((buf1["scroll_y"] / max_scroll1) * 100) if max_scroll1 > 0 else 100
                pos1 = "TOP" if buf1["scroll_y"] == 0 else ("BOT" if buf1["scroll_y"] >= max_scroll1 else f"{pct1:2d}%")

                is_act1 = (active_pane == 1)
                tag1 = " [ACTIVE] " if is_act1 else " "
                style1 = (curses.color_pair(5) | curses.A_BOLD) if is_act1 else (curses.color_pair(1) | curses.A_DIM)
                banner1 = f" [2/2]{tag1}{buf1['title'][:right_w - 18]} [{pos1}] "
                try:
                    stdscr.addstr(0, pane_w + 1, banner1.ljust(right_w)[:right_w], style1)
                except curses.error:
                    pass

                for r in range(view_h):
                    line_idx = buf1["scroll_y"] + r
                    if line_idx >= len(buf1["parsed_lines"]):
                        break
                    x = 0
                    for text_seg, attr in buf1["parsed_lines"][line_idx]:
                        if x >= col_w1:
                            break
                        clipped = text_seg[: max(0, col_w1 - x)]
                        try:
                            stdscr.addstr(r + 1, pane_w + 2 + x, clipped, attr)
                        except curses.error:
                            pass
                        x += len(clipped)

            # Bottom Status & Action Bar
            if split_prompt:
                bar1 = f" ➜ Open in split (URL / search): {split_buf}_  (Enter to open, Esc to cancel)"
                bar1_color = curses.color_pair(3) | curses.A_BOLD
            elif link_prompt or link_buf:
                dest = "Split Pane (F)" if link_open_split else "Current Pane (Enter)"
                bar1 = f" 🔗 Follow Link #{link_buf}_ in {dest}  (Type # and Enter, Esc to cancel)"
                bar1_color = curses.color_pair(3) | curses.A_BOLD
            elif status_note:
                bar1 = f" {status_note}"
                bar1_color = curses.color_pair(2) | curses.A_BOLD
            elif len(buffers) >= 2:
                bar1 = f" Pane [{active_pane + 1}/2] Active: {buffers[active_pane]['title'][:w - 35]}"
                bar1_color = curses.color_pair(5) | curses.A_BOLD
            else:
                bar1 = f" 📖 {buffers[0]['title'][:w - 25]}"
                bar1_color = curses.color_pair(5) | curses.A_BOLD

            if len(buffers) >= 2:
                bar2 = " j/k: Scroll | Tab: Switch Pane | f/F: Link | t: Split | x: Close Split | E: GUI | q: Quit"
            else:
                bar2 = " j/k: Scroll | f/F: Follow Link | t: Split View | E: GUI | b: Bookmark | s: Save | q: Quit"

            try:
                stdscr.addstr(h - 2, 0, bar1[:w - 1].ljust(w - 1), bar1_color)
                stdscr.addstr(h - 1, 0, bar2[:w - 1].ljust(w - 1), curses.A_BOLD)
            except curses.error:
                pass

            stdscr.refresh()
            key = stdscr.getch()

            # Handle Split input prompt
            if split_prompt:
                if key in (10, 13):  # Enter
                    query = split_buf.strip()
                    split_buf = ""
                    split_prompt = False
                    if query:
                        status_note = f"[*] Resolving '{query}'..."
                        stdscr.addstr(h - 2, 0, status_note.ljust(w - 1), curses.color_pair(3) | curses.A_BOLD)
                        stdscr.refresh()
                        target_url = resolve_url_or_search(query)
                        if target_url:
                            try:
                                status_note = f"[*] Extracting {target_url}..."
                                stdscr.addstr(h - 2, 0, status_note.ljust(w - 1), curses.color_pair(3) | curses.A_BOLD)
                                stdscr.refresh()
                                n_md, n_title, n_links, n_url = extract_content(target_url)
                                new_buf = {
                                    "url": n_url,
                                    "title": n_title or n_url,
                                    "md_text": n_md,
                                    "links": n_links,
                                    "scroll_y": 0,
                                    "rendered_width": None,
                                    "parsed_lines": []
                                }
                                if len(buffers) == 1:
                                    buffers.append(new_buf)
                                    active_pane = 1
                                    status_note = "[+] Opened side-by-side split on right"
                                else:
                                    buffers[active_pane] = new_buf
                                    status_note = f"[+] Loaded into pane [{active_pane + 1}]"
                            except Exception as e:
                                status_note = f"[!] Extraction error: {e}"
                        else:
                            status_note = "[-] Could not resolve URL or query."
                elif key == 27:  # Esc
                    split_buf = ""
                    split_prompt = False
                elif key in (curses.KEY_BACKSPACE, 127, 8):
                    split_buf = split_buf[:-1]
                elif 32 <= key <= 126:
                    split_buf += chr(key)
                continue

            # Handle Link buffer prompt
            if link_prompt or link_buf:
                if key in (10, 13):  # Enter
                    link_prompt = False
                    try:
                        num = int(link_buf)
                    except ValueError:
                        num = -1
                    target_links = buffers[active_pane]["links"]
                    match = [l for l in target_links if l[0] == num]
                    link_buf = ""
                    if match:
                        link_url = match[0][2]
                        status_note = f"[*] Loading link: {link_url}..."
                        stdscr.addstr(h - 2, 0, status_note.ljust(w - 1), curses.color_pair(3) | curses.A_BOLD)
                        stdscr.refresh()
                        try:
                            n_md, n_title, n_links, n_url = extract_content(link_url)
                            new_buf = {
                                "url": n_url,
                                "title": n_title or n_url,
                                "md_text": n_md,
                                "links": n_links,
                                "scroll_y": 0,
                                "rendered_width": None,
                                "parsed_lines": []
                            }
                            if link_open_split:
                                if len(buffers) == 1:
                                    buffers.append(new_buf)
                                    active_pane = 1
                                else:
                                    other = 1 - active_pane
                                    buffers[other] = new_buf
                                    active_pane = other
                                status_note = f"[+] Followed link to split pane [{active_pane + 1}]"
                            else:
                                buffers[active_pane] = new_buf
                                status_note = f"[+] Loaded link into pane [{active_pane + 1}]"
                        except Exception as e:
                            status_note = f"[!] Failed to load link: {e}"
                    else:
                        status_note = f"[-] Link [{num}] not found"
                elif key == 27:  # Esc
                    link_prompt = False
                    link_buf = ""
                elif key in (ord('T'), ord('t'), ord('F')):
                    link_open_split = not link_open_split
                elif key in (curses.KEY_BACKSPACE, 127, 8):
                    link_buf = link_buf[:-1]
                elif ord('0') <= key <= ord('9'):
                    link_buf += chr(key)
                continue

            # Mouse handling
            if key == curses.KEY_MOUSE:
                try:
                    _, mx, my, _, bstate = curses.getmouse()
                    if len(buffers) >= 2:
                        pane_w = (w - 1) // 2
                        hover_idx = 0 if mx < pane_w else 1
                        if bstate & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
                            active_pane = hover_idx
                        elif bstate & (curses.BUTTON4_PRESSED | 0x10000):
                            buffers[hover_idx]["scroll_y"] = max(0, buffers[hover_idx]["scroll_y"] - 3)
                        elif bstate & (getattr(curses, 'BUTTON5_PRESSED', 0x80000) | 0x80000):
                            ms = max(0, len(buffers[hover_idx]["parsed_lines"]) - view_h)
                            buffers[hover_idx]["scroll_y"] = min(ms, buffers[hover_idx]["scroll_y"] + 3)
                        else:
                            active_pane = hover_idx
                    else:
                        if bstate & (curses.BUTTON4_PRESSED | 0x10000):
                            buffers[0]["scroll_y"] = max(0, buffers[0]["scroll_y"] - 3)
                        elif bstate & (getattr(curses, 'BUTTON5_PRESSED', 0x80000) | 0x80000):
                            ms = max(0, len(buffers[0]["parsed_lines"]) - view_h)
                            buffers[0]["scroll_y"] = min(ms, buffers[0]["scroll_y"] + 3)
                except Exception:
                    pass
                continue

            status_note = ""

            # Keyboard scrolling strictly applies to active_pane
            cur_buf = buffers[active_pane]
            cur_max = max(0, len(cur_buf["parsed_lines"]) - view_h)

            if key in (ord('q'), 27):
                if len(buffers) >= 2:
                    buffers.pop(active_pane)
                    active_pane = 0
                    status_note = "[-] Closed split pane"
                else:
                    break
            elif key == ord('Q'):
                break
            elif key in (ord('x'), ord('\x17')):  # x or Ctrl-w
                if len(buffers) >= 2:
                    buffers.pop(active_pane)
                    active_pane = 0
                    status_note = "[-] Closed split pane"
                else:
                    break
            elif key in (ord('j'), curses.KEY_DOWN):
                cur_buf["scroll_y"] = min(cur_max, cur_buf["scroll_y"] + 1)
            elif key in (ord('k'), curses.KEY_UP):
                cur_buf["scroll_y"] = max(0, cur_buf["scroll_y"] - 1)
            elif key in (ord('d'), curses.KEY_NPAGE, ord(' ')):
                cur_buf["scroll_y"] = min(cur_max, cur_buf["scroll_y"] + view_h // 2)
            elif key in (ord('u'), curses.KEY_PPAGE):
                cur_buf["scroll_y"] = max(0, cur_buf["scroll_y"] - view_h // 2)
            elif key in (ord('g'), curses.KEY_HOME):
                cur_buf["scroll_y"] = 0
            elif key in (ord('G'), curses.KEY_END):
                cur_buf["scroll_y"] = cur_max
            elif key in (ord('\t'), 9, curses.KEY_BTAB):  # Tab toggles active pane
                if len(buffers) >= 2:
                    active_pane = 1 - active_pane
            elif key in (ord('h'), curses.KEY_LEFT):
                if len(buffers) >= 2:
                    active_pane = 0
            elif key in (ord('l'), curses.KEY_RIGHT):
                if len(buffers) >= 2:
                    active_pane = 1
            elif key in (ord('t'), ord('\x01'), ord('\x14')):  # t, Ctrl-a, or Ctrl-t -> open split
                split_prompt = True
                split_buf = ""
            elif key in (ord('f'), ord('F')):  # Follow link (f: current pane, F: split pane)
                link_prompt = True
                link_open_split = (key == ord('F'))
                link_buf = ""
            elif key == ord('T'):  # Follow link in new split
                link_prompt = True
                link_open_split = True
                link_buf = ""
            elif ord('1') <= key <= ord('9'):
                link_prompt = True
                link_open_split = False
                link_buf = chr(key)
            elif key in (ord('e'), ord('E')):
                # Escalate to wf-view with all currently open buffer URLs
                all_urls = [b["url"] for b in buffers]
                wf_view_bin = Path(__file__).resolve().parent / "wf-view"
                curses.def_prog_mode()
                curses.endwin()
                try:
                    subprocess.run([str(wf_view_bin), "--from-reader"] + all_urls)
                except Exception:
                    pass
                finally:
                    curses.reset_prog_mode()
                    stdscr.clear()
                    stdscr.refresh()
                status_note = "[*] Returned from GUI viewer (wf-view)"
            elif key in (ord('b'), ord('B')):
                bookmark(cur_buf["url"], cur_buf["title"])
                status_note = f"[+] Bookmarked pane [{active_pane + 1}]!"
            elif key in (ord('s'), ord('S')):
                save_dir = Path.home() / "Documents" / "Webflow"
                save_dir.mkdir(parents=True, exist_ok=True)
                safe_title = "".join(c if c.isalnum() or c in "-_ " else "_" for c in cur_buf["title"]).strip() or "article"
                target_file = save_dir / f"{safe_title}.md"
                target_file.write_text(f"# {cur_buf['title']}\n\n**Source**: [{cur_buf['url']}]({cur_buf['url']})\n\n---\n\n{cur_buf['md_text']}", encoding="utf-8")
                status_note = f"[+] Saved to ~/Documents/Webflow/{safe_title}.md"

    curses.wrapper(_curses_reader)


def main():
    if len(sys.argv) < 2:
        sys.stderr.write("Usage: wf-reader <url> [url2 ...]\n")
        sys.exit(1)

    urls = sys.argv[1:]
    initial_buffers = []

    for u in urls[:2]:
        u = u.strip()
        if not re.match(r"^https?://", u):
            u = "https://" + u
        print(f"[*] Extracting & typesetting: {u}...")
        try:
            md_text, title, links, final_url = extract_content(u)
            initial_buffers.append({
                "url": final_url,
                "title": title or final_url,
                "md_text": md_text,
                "links": links,
                "scroll_y": 0,
                "rendered_width": None,
                "parsed_lines": []
            })
        except Exception as e:
            sys.stderr.write(f"[!] Reader extraction failed for {u}: {e}\n")

    if not initial_buffers:
        print("[*] Escalating to Tier 3 (wf-view)...")
        wf_view_bin = Path(__file__).resolve().parent / "wf-view"
        os.execv(str(wf_view_bin), [str(wf_view_bin)] + urls)

    run_interactive_reader(initial_buffers)


if __name__ == "__main__":
    main()
