#!/usr/bin/env python3
"""
wf-reader - Tier 1: Terminal Markdown Extractor & Typeset Terminal Reader for Webflow
Extracts semantic text from web pages into clean Markdown and renders formatted ANSI typography.
"""
import os
import sys
import re
import html
import shutil
import textwrap
import curses
import urllib.request
import urllib.parse
import subprocess
from pathlib import Path
from html.parser import HTMLParser

VOID_TAGS = {
    "area", "base", "br", "col", "embed", "hr", "img", "input",
    "link", "meta", "param", "source", "track", "wbr"
}


class SemanticHTMLToMarkdown(HTMLParser):
    def __init__(self, base_url="", keep_nav_links=False):
        super().__init__()
        self.base_url = base_url
        self.output = []
        self.title = ""
        self.in_title = False
        self.in_pre = False
        self.ignored_tags = {
            "script", "style", "footer", "aside",
            "noscript", "iframe", "svg", "button", "form"
        }
        if not keep_nav_links:
            self.ignored_tags.update({"nav", "header", "figure", "figcaption"})
        self.ignore_stack = []
        self.current_href = None
        self.current_link_text = []

    def handle_starttag(self, tag, attrs):
        attrs_dict = dict(attrs)
        tag_lower = tag.lower()
        is_void = tag_lower in VOID_TAGS

        if self.ignore_stack:
            if not is_void:
                self.ignore_stack.append(tag_lower)
            return

        if tag_lower in self.ignored_tags:
            if not is_void:
                self.ignore_stack.append(tag_lower)
            return

        class_id = (
            attrs_dict.get("class", "") + " " +
            attrs_dict.get("id", "") + " " +
            attrs_dict.get("role", "")
        ).lower()
        noise_tokens = [
            "advert", "sidebar", "cookie", "consent", "footer", "menu",
            "mw-editsection", "reflist", "reference", "catlinks",
            "vector-header", "vector-page-toolbar", "vector-column-start",
            "mw-jump-link", "printfooter", "noprint", "ambox", "hatnote",
            "navbox", "sisterproject"
        ]
        if any(tok in class_id for tok in noise_tokens):
            if not is_void:
                self.ignore_stack.append(tag_lower)
            return

        if tag_lower == "title":
            self.in_title = True
        elif tag_lower in ["h1", "h2", "h3", "h4", "h5", "h6"]:
            level = int(tag_lower[1])
            self.output.append(f"\n\n{'#' * level} ")
        elif tag_lower in ["p", "div", "section", "article"]:
            self.output.append("\n\n")
        elif tag_lower == "blockquote":
            self.output.append("\n\n> ")
        elif tag_lower == "br":
            self.output.append("\n")
        elif tag_lower in ["li", "dt", "dd"]:
            self.output.append("\n* ")
        elif tag_lower in ["tr"]:
            self.output.append("\n")
        elif tag_lower in ["td", "th"]:
            self.output.append("  ")
        elif tag_lower in ["strong", "b"]:
            self.output.append(" **")
        elif tag_lower in ["em", "i"]:
            self.output.append(" *")
        elif tag_lower == "code" and not self.in_pre:
            self.output.append(" `")
        elif tag_lower == "pre":
            self.in_pre = True
            self.output.append("\n\n```\n")
        elif tag_lower == "a":
            href = attrs_dict.get("href", "")
            if href and not href.startswith(("#", "javascript:", "mailto:")):
                self.current_href = urllib.parse.urljoin(self.base_url, href)
                self.current_link_text = []

    def handle_endtag(self, tag):
        tag_lower = tag.lower()
        if tag_lower in VOID_TAGS:
            return

        if self.ignore_stack:
            # Pop matching tag or top of stack safely
            if tag_lower in self.ignore_stack:
                while self.ignore_stack:
                    popped = self.ignore_stack.pop()
                    if popped == tag_lower:
                        break
            else:
                self.ignore_stack.pop()
            return

        if tag_lower == "title":
            self.in_title = False
        elif tag_lower in ["h1", "h2", "h3", "h4", "h5", "h6"]:
            self.output.append("\n\n")
        elif tag_lower in ["strong", "b"]:
            self.output.append("** ")
        elif tag_lower in ["em", "i"]:
            self.output.append("* ")
        elif tag_lower == "code" and not self.in_pre:
            self.output.append("` ")
        elif tag_lower == "pre":
            self.in_pre = False
            self.output.append("\n```\n\n")
        elif tag_lower == "a" and self.current_href:
            link_text = " ".join("".join(self.current_link_text).split()).strip()
            if link_text and not re.match(r"^\[?\d+\]?$", link_text) and link_text.lower() not in ("edit", "edit source"):
                self.output.append(f" [{link_text}]({self.current_href}) ")
            elif link_text:
                self.output.append(f" {link_text} ")
            self.current_href = None
            self.current_link_text = []

    def handle_data(self, data):
        if self.ignore_stack:
            return
        if self.in_title:
            self.title += data
            return
        if not self.in_pre:
            data = re.sub(r"\s+", " ", data)
        if self.current_href is not None:
            self.current_link_text.append(data)
        else:
            self.output.append(data)

    def get_markdown(self):
        text = "".join(self.output)
        text = re.sub(r"[ \t]+", " ", text)
        text = re.sub(r"\n[ \t]+", "\n", text)
        text = re.sub(r"\n{3,}", "\n\n", text).strip()
        return text, self.title.strip()


def format_links_for_reading(md_text: str, base_url: str):
    links = []
    counter = 0

    def repl(match):
        nonlocal counter
        text = match.group(1).strip()
        href = match.group(2).strip()
        if not text or href.startswith(("#", "javascript:")):
            return text
        if re.match(r"^\[?\d+\]?$", text) or text.lower() in ("edit", "edit source"):
            return ""
        full_url = urllib.parse.urljoin(base_url, href)
        counter += 1
        links.append((counter, text, full_url))
        return f"**{text}** `[{counter}]`"

    cleaned = re.sub(r" `\[\d+\]`", "", md_text)
    processed = re.sub(r"\[([^\[\]]+)\]\(([^)\s]+)\)", repl, cleaned)
    return processed, links


def render_markdown_to_ansi(title: str, url: str, md_text: str, links: list) -> str:
    term_w = shutil.get_terminal_size((100, 30)).columns
    width = min(88, max(60, term_w - 8))
    pad = "    "

    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    ITALIC = "\033[3m"
    CYAN = "\033[36m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    MAGENTA = "\033[35m"

    def style_inline(line: str) -> str:
        line = re.sub(r"`\[(\d+)\]`", f"{YELLOW}[\\1]{RESET}", line)
        line = re.sub(r"`([^`]+)`", f"{MAGENTA}\\1{RESET}", line)
        line = re.sub(r"\*\*([^*]+)\*\*", f"{BOLD}{CYAN}\\1{RESET}", line)
        line = re.sub(r"\*([^*]+)\*", f"{ITALIC}\\1{RESET}", line)
        return line

    out = []
    out.append("")
    out.append(f"{pad}{BOLD}{CYAN}┏{'━' * (width - 2)}┓{RESET}")
    for t_line in textwrap.wrap(title, width=width - 6) or [title]:
        out.append(f"{pad}{BOLD}{CYAN}┃{RESET}  {BOLD}{t_line.ljust(width - 6)}{RESET}  {BOLD}{CYAN}┃{RESET}")
    out.append(f"{pad}{BOLD}{CYAN}┗{'━' * (width - 2)}┛{RESET}")
    out.append(f"{pad}{DIM}Source: {url}{RESET}")
    out.append(f"{pad}{DIM}{'─' * width}{RESET}\n")

    paragraphs = md_text.split("\n\n")

    for block in paragraphs:
        block = block.strip()
        if not block:
            continue

        if block.startswith("```"):
            lines = block.splitlines()
            out.append(f"{pad}{DIM}┌── code {'─' * (width - 10)}┐{RESET}")
            for cl in lines[1:]:
                if cl.strip() == "```":
                    continue
                out.append(f"{pad}{DIM}│{RESET} {MAGENTA}{cl}{RESET}")
            out.append(f"{pad}{DIM}└{'─' * (width - 2)}┘{RESET}\n")
            continue

        if block.startswith("#"):
            m = re.match(r"^(#+)\s*(.*)", block, re.DOTALL)
            if m:
                level = len(m.group(1))
                h_text = " ".join(m.group(2).split())
                h_text = re.sub(r"\*\*([^*]+)\*\*", r"\1", h_text)
                h_text = re.sub(r"`\[\d+\]`", "", h_text).strip()
                if not h_text:
                    continue
                if level == 1:
                    out.append(f"\n{pad}{BOLD}{GREEN}██ {h_text.upper()}{RESET}")
                    out.append(f"{pad}{GREEN}{'═' * min(len(h_text) + 3, width)}{RESET}\n")
                elif level == 2:
                    out.append(f"\n{pad}{BOLD}{CYAN}▌ {h_text}{RESET}")
                    out.append(f"{pad}{DIM}{'─' * min(len(h_text) + 2, width)}{RESET}\n")
                else:
                    out.append(f"\n{pad}{BOLD}{YELLOW}• {h_text}{RESET}\n")
                continue

        if block.startswith("* ") or block.startswith("- "):
            for item in block.splitlines():
                item_clean = re.sub(r"^[\*\-]\s+", "", item.strip())
                if not item_clean:
                    continue
                wrapped = textwrap.wrap(item_clean, width=width - 4)
                for idx, wline in enumerate(wrapped):
                    prefix = f"{pad}  {CYAN}•{RESET} " if idx == 0 else f"{pad}    "
                    out.append(prefix + style_inline(wline))
            out.append("")
            continue

        if block.startswith(">"):
            q_clean = re.sub(r"^>\s*", "", block, flags=re.MULTILINE)
            for wline in textwrap.wrap(q_clean, width=width - 4):
                out.append(f"{pad}{YELLOW}│{RESET} {ITALIC}{style_inline(wline)}{RESET}")
            out.append("")
            continue

        wrapped = textwrap.wrap(block, width=width)
        for wline in wrapped:
            out.append(f"{pad}{style_inline(wline)}")
        out.append("")

    if links:
        out.append(f"\n{pad}{BOLD}{CYAN}▌ Hyperlink Reference Index (Type 1..{len(links)}){RESET}")
        out.append(f"{pad}{DIM}{'─' * width}{RESET}")
        for num, ltext, lurl in links[:60]:
            short_t = (ltext[:32] + "…") if len(ltext) > 33 else ltext
            short_u = (lurl[:width - 42] + "…") if len(lurl) > (width - 41) else lurl
            out.append(f"{pad}{YELLOW}[{num:2d}]{RESET} {BOLD}{short_t:<34}{RESET} {DIM}{short_u}{RESET}")
        if len(links) > 60:
            out.append(f"{pad}{DIM}... and {len(links) - 60} more links.{RESET}")
        out.append("")

    return "\n".join(out)


def extract_content(url: str):
    # Redirect bare www.wikipedia.org splash portal to English Main_Page
    parsed = urllib.parse.urlparse(url)
    if parsed.netloc in ("www.wikipedia.org", "wikipedia.org") and parsed.path in ("", "/"):
        url = "https://en.wikipedia.org/wiki/Main_Page"

    headers = {
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0"
    }
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=10) as resp:
        raw_html = resp.read().decode("utf-8", errors="replace")

    try:
        import trafilatura
        extracted = trafilatura.extract(
            raw_html,
            include_links=True,
            include_tables=False,
            output_format="markdown"
        )
        if extracted and len(extracted) > 400:
            meta = trafilatura.extract_metadata(raw_html)
            title = (meta.title if meta and meta.title else None) or url
            md_clean, links = format_links_for_reading(extracted, url)
            return md_clean, title, links, url
    except ImportError:
        pass

    body_html = raw_html
    for pattern in [
        r'<div[^>]+id=["\']mw-content-text["\'][^>]*>(.*?)<div class=["\']printfooter["\']',
        r'<main[^>]*>(.*?)</main>',
        r'<article[^>]*>(.*?)</article>'
    ]:
        m = re.search(pattern, raw_html, re.DOTALL | re.IGNORECASE)
        if m and len(m.group(1)) > 400:
            body_html = m.group(1)
            break

    title_m = re.search(r"<title[^>]*>(.*?)</title>", raw_html, re.DOTALL | re.IGNORECASE)
    doc_title = html.unescape(re.sub(r"<[^>]+>", "", title_m.group(1)).strip()) if title_m else url

    parser = SemanticHTMLToMarkdown(base_url=url, keep_nav_links=False)
    parser.feed(body_html)
    raw_md, parsed_title = parser.get_markdown()

    # Fallback: if page is a link hub / portal with very little prose, re-parse keeping nav links
    if len(raw_md) < 200:
        parser2 = SemanticHTMLToMarkdown(base_url=url, keep_nav_links=True)
        parser2.feed(raw_html)
        raw_md, parsed_title = parser2.get_markdown()

    final_title = parsed_title or doc_title
    md_clean, links = format_links_for_reading(raw_md, url)
    return md_clean, final_title, links, url


def bookmark(url: str, title: str):
    bm_file = Path.home() / ".local" / "share" / "webflow" / "bookmarks.txt"
    bm_file.parent.mkdir(parents=True, exist_ok=True)
    with open(bm_file, "a", encoding="utf-8") as f:
        f.write(f"{url} | {title} | general\n")
    print(f"\n[+] Bookmarked: {url} | {title}")


ANSI_SPLIT_RE = re.compile(r"(\033\[[0-9;]*m)")

def parse_ansi_line(line: str):
    """Converts ANSI escape codes from render_markdown_to_ansi into curses attributes."""
    segments = []
    attr = curses.A_NORMAL
    parts = ANSI_SPLIT_RE.split(line)
    for part in parts:
        if not part:
            continue
        if part.startswith("\033["):
            code = part[2:-1]
            if code == "0":
                attr = curses.A_NORMAL
            elif code == "1":
                attr |= curses.A_BOLD
            elif code == "2":
                attr |= curses.A_DIM
            elif code == "3":
                attr |= getattr(curses, "A_ITALIC", curses.A_NORMAL)
            elif code == "36":
                attr = (attr & ~curses.A_COLOR) | curses.color_pair(1)
            elif code == "32":
                attr = (attr & ~curses.A_COLOR) | curses.color_pair(2)
            elif code == "33":
                attr = (attr & ~curses.A_COLOR) | curses.color_pair(3)
            elif code == "35":
                attr = (attr & ~curses.A_COLOR) | curses.color_pair(4)
        else:
            segments.append((part, attr))
    return segments


def run_interactive_reader(url: str, title: str, md_text: str, links: list):
    ansi_doc = render_markdown_to_ansi(title, url, md_text, links)
    raw_lines = ansi_doc.splitlines()

    action_After = {"type": None, "payload": None}

    def _curses_reader(stdscr):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            curses.init_pair(2, curses.COLOR_GREEN, -1)
            curses.init_pair(3, curses.COLOR_YELLOW, -1)
            curses.init_pair(4, curses.COLOR_MAGENTA, -1)
            curses.init_pair(5, curses.COLOR_BLACK, curses.COLOR_CYAN)

        parsed_lines = [parse_ansi_line(l) for l in raw_lines]
        scroll_y = 0  # ALWAYS starts at top of document (line 0)
        link_buf = ""
        status_note = ""

        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            view_h = max(1, h - 2)
            max_scroll = max(0, len(parsed_lines) - view_h)
            scroll_y = max(0, min(scroll_y, max_scroll))

            # Render visible lines from scroll_y
            for row_idx in range(view_h):
                line_idx = scroll_y + row_idx
                if line_idx >= len(parsed_lines):
                    break
                x = 0
                for text_seg, attr in parsed_lines[line_idx]:
                    if x >= w - 1:
                        break
                    clipped = text_seg[: max(0, w - 1 - x)]
                    try:
                        stdscr.addstr(row_idx, x, clipped, attr)
                    except curses.error:
                        pass
                    x += len(clipped)

            # Top/Bottom progress percentage
            pct = int((scroll_y / max_scroll) * 100) if max_scroll > 0 else 100
            pos_label = "TOP" if scroll_y == 0 else ("BOT" if scroll_y >= max_scroll else f"{pct:2d}%")

            # Status & Action Bar at bottom
            bar1 = f" 📖 {title[:w-25]} ".ljust(w - 12) + f" [{pos_label}] "
            if link_buf:
                bar2 = f" Follow Link #{link_buf}_  (Press Enter to open, Esc to cancel)"
            elif status_note:
                bar2 = f" {status_note}  |  j/k Scroll  d/u Half-Page  1-9 Link#  E GUI  b Bookmark  s Save  q Quit"
            else:
                bar2 = " j/k Scroll  |  d/u Page  |  g/G Top/Bot  |  0-9 Follow Link  |  E GUI  |  b Mark  |  s Save  |  q Quit"

            try:
                stdscr.addstr(h - 2, 0, bar1[:w - 1].ljust(w - 1), curses.color_pair(5) | curses.A_BOLD)
                stdscr.addstr(h - 1, 0, bar2[:w - 1].ljust(w - 1), curses.A_BOLD)
            except curses.error:
                pass

            stdscr.refresh()
            key = stdscr.getch()

            if link_buf:
                if key in (10, 13):  # Enter
                    try:
                        num = int(link_buf)
                    except ValueError:
                        num = -1
                    link_buf = ""
                    match = [l for l in links if l[0] == num]
                    if match:
                        action_After["type"] = "link"
                        action_After["payload"] = match[0][2]
                        break
                    else:
                        status_note = f"[-] Link [{num}] not found (1..{len(links)})"
                elif key == 27:  # Escape
                    link_buf = ""
                elif key in (curses.KEY_BACKSPACE, 127, 8):
                    link_buf = link_buf[:-1]
                elif ord('0') <= key <= ord('9'):
                    link_buf += chr(key)
                continue

            status_note = ""
            if key in (ord('q'), ord('Q'), 27):
                break
            elif key in (ord('j'), curses.KEY_DOWN, 10, 13):
                scroll_y += 1
            elif key in (ord('k'), curses.KEY_UP):
                scroll_y -= 1
            elif key in (ord('d'), curses.KEY_NPAGE, ord(' ')):
                scroll_y += view_h // 2
            elif key in (ord('u'), curses.KEY_PPAGE):
                scroll_y -= view_h // 2
            elif key == ord('g') or key == curses.KEY_HOME:
                scroll_y = 0
            elif key == ord('G') or key == curses.KEY_END:
                scroll_y = max_scroll
            elif key in (ord('e'), ord('E')):
                wf_view_bin = Path(__file__).resolve().parent / "wf-view"
                curses.def_prog_mode()
                curses.endwin()
                try:
                    subprocess.run([str(wf_view_bin), "--from-reader", url])
                except Exception:
                    pass
                finally:
                    curses.reset_prog_mode()
                    stdscr.clear()
                    stdscr.refresh()
                status_note = "[*] Returned from GUI viewer (wf-view)"
            elif key in (ord('b'), ord('B')):
                bookmark(url, title)
                status_note = "[+] Bookmarked page!"
            elif key in (ord('s'), ord('S')):
                save_dir = Path.home() / "Documents" / "Webflow"
                save_dir.mkdir(parents=True, exist_ok=True)
                safe_title = "".join(c if c.isalnum() or c in "-_ " else "_" for c in title).strip() or "article"
                target_file = save_dir / f"{safe_title}.md"
                target_file.write_text(f"# {title}\n\n**Source**: [{url}]({url})\n\n---\n\n{md_text}", encoding="utf-8")
                status_note = f"[+] Saved to ~/Documents/Webflow/{safe_title}.md"
            elif ord('1') <= key <= ord('9'):
                link_buf = chr(key)

    curses.wrapper(_curses_reader)

    if action_After["type"] == "link" and action_After["payload"]:
        wf_open_bin = Path(__file__).resolve().parent / "wf-open"
        os.execv(str(wf_open_bin), [str(wf_open_bin), action_After["payload"]])


def main():
    if len(sys.argv) < 2:
        sys.stderr.write("Usage: wf-reader <url>\n")
        sys.exit(1)

    url = sys.argv[1].strip()
    if not re.match(r"^https?://", url):
        url = "https://" + url

    print(f"[*] Extracting & typesetting: {url}...")
    try:
        md_text, title, links, url = extract_content(url)
        if not title:
            title = url
        run_interactive_reader(url, title, md_text, links)
    except Exception as e:
        sys.stderr.write(f"[!] Reader extraction failed: {e}\n")
        print("[*] Escalating to Tier 3 (wf-view)...")
        wf_view_bin = Path(__file__).resolve().parent / "wf-view"
        os.execv(str(wf_view_bin), [str(wf_view_bin), url])


if __name__ == "__main__":
    main()
